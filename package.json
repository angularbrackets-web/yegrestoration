{
  "name": "yeg-restoration",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && svelte-check --tsconfig ./tsconfig.json --output human",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:status": "tsx scripts/migrate.ts --status",
    "verify:env": "tsx scripts/verify-env.ts",
    "verify:contact": "tsx scripts/verify-contact.ts",
    "verify:cutover": "tsx scripts/verify-cutover.ts && npm run build",
    "verify:slots": "tsx scripts/verify-slots.ts",
    "verify:availability": "tsx scripts/verify-availability.ts",
    "verify:availability:db": "tsx scripts/verify-availability-db.ts",
    "verify:booking:payload": "tsx scripts/verify-booking-payload.ts",
    "verify:booking:pricing": "tsx scripts/verify-booking-pricing.ts",
    "verify:booking:commit": "tsx scripts/verify-booking-commit.ts",
    "verify:booking:form": "tsx scripts/verify-booking-form.ts",
    "verify:booking:preview": "tsx scripts/verify-booking-preview.ts",
    "verify:booking:review": "tsx scripts/verify-booking-review.ts",
    "verify:booking:confirmation": "tsx scripts/verify-booking-confirmation.ts",
    "verify:booking:email": "tsx scripts/verify-booking-email.ts",
    "verify:booking:ics": "tsx scripts/verify-booking-ics.ts",
    "verify:booking:smoke": "tsx scripts/verify-booking-smoke.ts",
    "verify:booking:admin": "tsx scripts/verify-booking-admin.ts",
    "verify:booking:admin:entry": "tsx scripts/verify-booking-admin-entry.ts",
    "verify:booking:admin:db": "tsx scripts/verify-booking-admin-db.ts",
    "verify:booking:files": "tsx scripts/verify-booking-files.ts",
    "verify:appointment:upload": "npm run build && tsx scripts/verify-appointment-upload.ts",
    "verify:stripe:webhook": "npm run build && tsx scripts/verify-stripe-webhook.ts",
    "verify:reveal": "npm run build && tsx scripts/verify-reveal.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/vercel": "^11.0.2",
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "clsx": "^2.1.1",
    "gsap": "^3.14.2",
    "resend": "^6.12.2",
    "stripe": "^22.5.0",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/svelte": "^9.0.1",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.6",
    "svelte": "^5.0.0",
    "svelte-check": "^4.7.5",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.23.1",
    "typescript": "^5.0.0"
  }
}
