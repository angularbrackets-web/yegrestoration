---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  ADMIN_APPOINTMENTS_PATH,
  ADMIN_APPOINTMENT_FILE_DELETE_ENDPOINT,
  ADMIN_APPOINTMENT_MARK_PAID_ENDPOINT,
  adminAppointmentPath,
  ADMIN_APPOINTMENT_RESEND_ENDPOINT,
  ADMIN_APPOINTMENT_REVIEW_ENDPOINT,
  ADMIN_APPOINTMENT_UPDATE_ENDPOINT,
  adminFilePath,
  customerStampState,
  FILE_SOURCE_LABELS,
  formatAdminTimestamp,
  formatFileSize,
  internalStampState,
  PAYMENT_ROUTE_LABELS,
  PIPELINE_STAGE_LABELS,
  STATUS_LABELS,
} from '../../../lib/booking-admin';
import {
  APPOINTMENT_STATUSES,
  editorStatusTargets,
  MAX_FILE_DELETE_NOTE,
  MAX_STORED_ADMIN_NOTES,
  PIPELINE_STAGES,
} from '../../../lib/booking-admin-entry';
import { ASSESSMENT_TIER_NAMES, TIMEZONE_NOTE } from '../../../lib/booking-copy';
import {
  ASSESSMENT_TIERS,
  assessmentQuote,
  formatCents,
} from '../../../lib/booking-pricing';
import { paymentDeadline, amountField, parseAmountCents } from '../../../lib/booking-review';
import { TRAVEL_FEE_CENTS_PER_KM, TRAVEL_FEE_FREE_RADIUS_KM, gstFor } from '../../../lib/booking-pricing';
import {
  APPOINTMENT_UPLOAD_TTL_HOURS,
  appointmentUploadUrl,
} from '../../../lib/booking-config';
import {
  DECISION_ENTRY_STATUSES,
  INVITE_HOLDING_STATUSES,
} from '../../../lib/booking-status';
import { formatSlot } from '../../../lib/booking-time';
import { issueAppointmentUploadToken } from '../../../lib/draft-token';
import AppointmentUpload from '../../../components/AppointmentUpload.svelte';
import { getDb, SERVICE_LABELS, type Appointment, type AppointmentFile } from '../../../lib/db';

// Validate before querying. The driver parameterizes, so this is defense in
// depth — its visible job is turning /admin/appointments/abc into a clean 404
// instead of a 500 from Postgres rejecting the cast. The upper bound is int4's:
// `id` is a SERIAL, and a larger number is a 22003 error, not a missing row.
// No leading zeros: /admin/appointments/0000000012/ is a second URL for the
// same row, and the canonical one is one character away.
const raw = Astro.params.id;
const id = typeof raw === 'string' && /^[1-9][0-9]{0,9}$/.test(raw) ? Number(raw) : null;
if (id === null || id < 1 || id > 2147483647) {
  return new Response('Not found', { status: 404 });
}

let appointment: Appointment | null = null;
let files: AppointmentFile[] = [];
let dbError: string | null = null;

try {
  const sql = getDb();
  const rows = (await sql`SELECT * FROM appointments WHERE id = ${id}`) as Appointment[];
  appointment = rows[0] ?? null;

  if (appointment) {
    // Deleted rows are fetched, not filtered out in SQL: this page is the one
    // place that has to SHOW a removal happened (see the "Removed" block).
    // Every other consumer — the file proxy, the upload caps, the list page's
    // count — excludes them at the query.
    files = (await sql`
      SELECT * FROM appointment_files WHERE appointment_id = ${id} ORDER BY id
    `) as AppointmentFile[];
  }
} catch (e) {
  dbError = 'Could not load appointment.';
  console.error(e);
}

/**
 * What this assessment comes to, if a tier was chosen.
 *
 * Recomputed from `(tier, service, slot_start)` rather than read off a column,
 * because there is no amount column yet — BK-32 adds one, snapshotted at
 * approval, and at that point this display should read the snapshot instead so
 * the office sees what the customer was actually quoted rather than what the
 * table says today.
 */
const quote =
  appointment && appointment.assessment_tier
    ? assessmentQuote({
        tier: appointment.assessment_tier,
        service: appointment.service,
        slotStart: appointment.slot_start,
      })
    : null;

// A row that does not exist is a 404, the same answer a bad id gets. A database
// that is down is not — that renders the error card below.
if (!appointment && !dbError) {
  return new Response('Not found', { status: 404 });
}

/**
 * BK-34a. The photo-upload capability for this appointment, in two forms: a
 * link the office texts, and the same uploader inline for an agent who already
 * has the files in their inbox.
 *
 * Minted here, in the page, because the page is already behind the middleware —
 * `/admin` is gated by prefix, so reaching this frontmatter *is* the
 * authorization, and a separate mint endpoint would only be a second thing to
 * protect.
 *
 * A FRESH TOKEN ON EVERY PAGE VIEW, which is deliberate rather than wasteful.
 * The caps count against `appointment_id` and not against the prefix, so a new
 * `draftId` grants no new budget; what it does mean is that links rotate, and
 * that a link pasted into a text message three weeks ago is not the same
 * capability as the one on screen now.
 *
 * Failure is non-fatal: this is a convenience on a page whose job is showing
 * the appointment. `BOOKING_DRAFT_SECRET` being unset must not 500 the record.
 *
 * BK-40 MAKES IT TWO TOKENS, NOT ONE. They authorize exactly the same writes
 * and differ only in the signed `origin` they carry, which is what
 * `appointment_files.source` records. The link token stays `'link'` —
 * byte-identical to what BK-34a shipped, so links already sitting in customers'
 * messages keep working — and the inline uploader gets its own `'office'` one.
 * Minting the office token HERE, server-side behind the middleware, is what
 * makes the claim trustworthy: the browser never chooses it, and it never
 * appears in the URL the office pastes into a text message.
 */
let uploadToken: string | null = null;
let uploadExpiresAt: Date | null = null;
let officeToken: string | null = null;
let officeDraftId: string | null = null;
if (appointment) {
  try {
    const [linkMint, officeMint] = await Promise.all([
      issueAppointmentUploadToken(appointment.id),
      issueAppointmentUploadToken(appointment.id, new Date(), 'office'),
    ]);
    uploadToken = linkMint.token;
    uploadExpiresAt = linkMint.expiresAt;
    officeToken = officeMint.token;
    officeDraftId = officeMint.draftId;
  } catch (e) {
    console.error(`Could not mint an upload token for appointment ${appointment.id}:`, e);
  }
}
const uploadLink = uploadToken
  ? new URL(appointmentUploadUrl(uploadToken), Astro.site ?? Astro.url.origin).toString()
  : null;

// Four states per stamp, not two. `none` is BK-08's addition: an admin row with
// an email may simply not have been sent one, which "Not applicable" would now
// claim falsely.
const liveFiles = files.filter(f => f.deleted_at == null);
const deletedFiles = files.filter(f => f.deleted_at != null);

const customerStamp = appointment ? customerStampState(appointment) : 'not-applicable';
const internalStamp = appointment ? internalStampState(appointment) : 'not-applicable';

// The confirmation button is offered only for a confirmed appointment with an
// email. A cancelled or no-show row must not be told again that its assessment
// is confirmed for a slot that may since belong to somebody else — and the
// endpoint re-checks this rather than trusting the button's absence.
//
// Since BK-45 it re-sends the SAME message the customer received when they
// paid, rather than a fuller one under a different heading.
const canResend =
  !!appointment &&
  appointment.status === 'confirmed' &&
  typeof appointment.email === 'string' &&
  appointment.email.trim() !== '';

// Flashes. The `?email=` one is load-bearing rather than decorative: BK-07's
// warning flags deliberately never fire for `source = 'admin'` rows, so this is
// the only place a failed admin-entry send is surfaced at the moment it
// happens. Afterwards the neutral stamp and the resend button are the recovery.
const emailFlash = Astro.url.searchParams.get('email');
const savedFlash = Astro.url.searchParams.get('saved');

const EMAIL_MESSAGES: Record<string, { tone: 'ok' | 'warn'; text: string }> = {
  sent: { tone: 'ok', text: 'Confirmation email sent to the customer.' },
  failed: {
    tone: 'warn',
    text: 'The confirmation email did not send. The appointment is saved — use “Send confirmation” below to try again.',
  },
  // Reached from the entry form with the box unticked, and from either sender
  // when the mute flag is set. Worded for both — the page they are looking at
  // is itself the evidence the appointment saved.
  off: { tone: 'ok', text: 'No confirmation email was sent.' },
  refused: {
    tone: 'warn',
    text: 'A confirmation is only sent for a booked appointment with an email address.',
  },
};

const SAVED_MESSAGES: Record<string, { tone: 'ok' | 'warn'; text: string }> = {
  '1': { tone: 'ok', text: 'Saved.' },
  conflict: {
    tone: 'warn',
    text: 'That slot has since been rebooked, so this appointment stays cancelled. Nothing was saved.',
  },
  invalid: { tone: 'warn', text: 'That edit was not valid. Nothing was saved.' },
  // BK-44. "Nothing at all was saved" is load-bearing rather than emphatic: the
  // whole edit is ONE statement, so a note, a stage or an assessment typed
  // alongside a refused status is discarded with it. A message that only
  // mentioned the status would leave somebody believing their note went in.
  blocked: {
    tone: 'warn',
    // THREE refusal reasons, not two. The live-session walk-back was folded in
    // after this message was first drafted, and a flash that named only
    // approving and confirming told somebody who had tried to REOPEN a booking
    // about two controls they had not touched. Deliberately says no "above":
    // which panels are on screen depends on the status, and this string cannot
    // know which one the office was looking at.
    text:
      'That status is not set here. Approving is “Review this request”; confirming is the ' +
      'customer paying or “Mark as paid — Interac”; and a booking cannot be reopened while ' +
      'its payment link is still live. Nothing at all was saved, including any note or stage ' +
      'changed at the same time.',
  },
  error: { tone: 'warn', text: 'The database rejected that change. Nothing was saved.' },
};

// BK-40. `gone` and `db` can only be READ here, never reached — both redirect
// to the list page, because which appointment the click came from is not
// knowable without trusting the form. They are in the map so that a
// hand-typed `?files=` renders a sentence rather than nothing, on the same
// reasoning as the entry form's field-label map.
const FILE_MESSAGES: Record<string, { tone: 'ok' | 'warn'; text: string }> = {
  removed: {
    tone: 'ok',
    text: 'File removed. It stays listed under “Removed” below, so the record of it survives.',
  },
  gone: { tone: 'warn', text: 'That file was already removed, or is not attached to an appointment.' },
  badid: { tone: 'warn', text: 'That file could not be identified. Nothing was removed.' },
  form: { tone: 'warn', text: 'That request was not valid. Nothing was removed.' },
  db: { tone: 'warn', text: 'The database rejected that change. Nothing was removed.' },
};

const filesFlash = Astro.url.searchParams.get('files');

/**
 * The review outcomes (BK-23).
 *
 * Every refusal below leaves the row in `pending_review`, and each message says
 * what to do about it — a decision screen that reports "that did not work" and
 * stops is a screen somebody clicks again.
 */
const REVIEW_MESSAGES: Record<string, { tone: 'ok' | 'warn'; text: string }> = {
  approved: {
    tone: 'ok',
    text: 'Approved. The customer has been emailed the amount, the deadline and how to pay.',
  },
  'approved-nomail': {
    tone: 'warn',
    text: 'Approved and the time is held — but the email did not send. Call the customer: they have no way to pay and the reservation is on a clock.',
  },
  declined: { tone: 'ok', text: 'Declined, and the time is back on the calendar.' },
  'declined-nomail': {
    tone: 'warn',
    text: 'Declined and the time is released, but the notice did not send. The customer has not been told.',
  },
  // Refusals. None of these changed anything.
  notier: {
    tone: 'warn',
    text: 'Choose an assessment first — the amount comes from it. Nothing was approved.',
  },
  elapsed: {
    tone: 'warn',
    text: 'That time has already passed, so it cannot be approved or paid for. Nothing was approved — decline it, or call the customer to rebook.',
  },
  amount: { tone: 'warn', text: 'That assessment amount was not a valid figure. Nothing was approved.' },
  travel: { tone: 'warn', text: 'That travel fee was not a valid figure. Nothing was approved.' },
  // Still no "mark it paid" here, even though BK-32 has now built that action.
  // The Interac button lives on an APPROVED row, and this message is about a
  // row that could not be approved at all — pointing at it would send the
  // office to a button that is not on the page. The only move that exists at
  // this moment is the same one as before: get an address onto the row, from
  // the edit form directly above.
  noemail: {
    tone: 'warn',
    text: 'This booking has no email address, so there is nowhere to send a payment link and nothing was approved. Add one above — a phone booking still needs an address to be paid for. If the customer has none, call the office before promising a visit.',
  },
  nopayment: {
    tone: 'warn',
    text: 'No way to take payment is configured, so the customer could not be told how to pay. Nothing was approved.',
  },
  // Not an error: somebody else got there first, or a double-click arrived
  // twice. Said plainly so nobody goes looking for a fault.
  stale: {
    tone: 'ok',
    text: 'This request had already been reviewed, so nothing changed and no second email went out.',
  },
  // BK-32. Approved, but the card link could not be minted — Stripe is not
  // configured, refused, or timed out. NOT a failure: the Interac route is a
  // complete way to pay and the customer has been told about it.
  'approved-interac': {
    tone: 'ok',
    text: 'Approved. The card link could not be created, so the customer was emailed the e-Transfer details and the amount. They can still pay.',
  },
  // BK-32. A $0.00 total: approved and confirmed in one step, with no payment
  // page and no payment link, because there is nothing to pay.
  'approved-free': {
    tone: 'ok',
    text: 'Approved at no charge and confirmed. The customer has their confirmation and calendar invite; no payment was asked for.',
  },
  // BK-32. A re-approval could not kill the previous Checkout Session, so
  // nothing was changed rather than leaving two live links at two prices.
  'stale-session': {
    tone: 'warn',
    text: 'The previous payment link could not be cancelled, so nothing was approved — approving would have left the customer holding two live links at two different prices. Try again; if it keeps failing, expire the session by hand in the Stripe dashboard.',
  },
  invalid: { tone: 'warn', text: 'That request was not valid. Nothing changed.' },
  error: { tone: 'warn', text: 'The database rejected that decision. Nothing changed.' },
};

/** BK-32 — the outcomes of "Mark as paid — Interac". */
const PAID_MESSAGES: Record<string, { tone: 'ok' | 'warn'; text: string }> = {
  paid: {
    tone: 'ok',
    text: 'Marked as paid by e-Transfer. The customer has been sent their confirmation and calendar invite.',
  },
  // Not an error, and deliberately quiet: this is a second click, not a second
  // payment. Saying "already done" beats a puzzling no-op.
  already: {
    tone: 'ok',
    text: 'This payment was already recorded, so nothing changed and no second confirmation went out.',
  },
  // The real double-pay race. Never auto-refunded — see the row's attention note.
  double: {
    tone: 'warn',
    text: 'This booking was ALREADY confirmed by a different payment. Nothing was changed and nothing was refunded — read the attention note below and sort the refund out by hand in Stripe.',
  },
  late: {
    tone: 'warn',
    text: 'The slot for this booking had already been released, so the payment was recorded but the booking was NOT confirmed. Nothing was refunded automatically — read the attention note below.',
  },
  notawaiting: {
    tone: 'warn',
    text: 'This booking is not awaiting payment, so there was nothing to mark. Nothing changed.',
  },
  missing: { tone: 'warn', text: 'That booking no longer exists. Nothing changed.' },
  error: { tone: 'warn', text: 'The database rejected that. Nothing changed.' },
};

const reviewFlash = Astro.url.searchParams.get('review');
const paidFlash = Astro.url.searchParams.get('paid');

const flashes = [
  emailFlash ? EMAIL_MESSAGES[emailFlash] : null,
  savedFlash ? SAVED_MESSAGES[savedFlash] : null,
  filesFlash ? FILE_MESSAGES[filesFlash] : null,
  reviewFlash ? REVIEW_MESSAGES[reviewFlash] : null,
  paidFlash ? PAID_MESSAGES[paidFlash] : null,
].filter((f): f is { tone: 'ok' | 'warn'; text: string } => !!f);

/**
 * The suggested amounts for the approval screen.
 *
 * Computed from the row's own `(tier, service, slot)`, so the office sees the
 * weekend rate and the mould price without doing anything. They are a
 * PRE-FILL, not a decision: the server recomputes the suggestion and accepts
 * an override, and nothing on this page is trusted on the way back.
 */
const suggestedQuote =
  appointment && appointment.assessment_tier
    ? assessmentQuote({
        tier: appointment.assessment_tier,
        service: appointment.service,
        slotStart: appointment.slot_start,
      })
    : null;

const isPendingReview = appointment?.status === 'pending_review';
/** BK-32 — the only status the Interac action applies to. */
const isAwaitingPayment = appointment?.status === 'approved_awaiting_payment';

// ── BK-44: what the Update panel may offer, and what it may claim ──────────
//
// `editorStatusTargets` is the rule `update.ts`'s WHERE clause is transcribed
// from. Rendering it here is what stops the dropdown offering a transition the
// server will refuse; it is not what stops the transition.
const statusTargets = appointment ? editorStatusTargets(appointment) : [];
const withheldStatuses = appointment
  ? APPOINTMENT_STATUSES.filter(s => !statusTargets.includes(s))
  : [];

// WITHHELD FOR THREE DIFFERENT REASONS, so it takes three sentences.
//
// The first version of this derived the LIST per row and then explained it with
// one fixed sentence — "Those come from approving and from payment" — which is
// false in every one of the eight states. On an unpaid request the withheld set
// includes `completed` and `no_show`, and neither of those is produced by
// approving or by taking money; they are withheld because the booking has never
// crossed the invite boundary. A claim rendered over a derived list has to be
// derived too, or it is just a constant wearing a variable's clothes.
const reopenWithheld = withheldStatuses.includes('pending_review');
const decisionWithheld = withheldStatuses.filter(s => DECISION_ENTRY_STATUSES.includes(s));
const untilPaidWithheld = withheldStatuses.filter(
  s => INVITE_HOLDING_STATUSES.includes(s) && !DECISION_ENTRY_STATUSES.includes(s),
);

/**
 * WHERE THE DECISION IS, named ONLY where that control is on the page.
 *
 * Half of BK-44 was that the screen never said which panel was the decision.
 * The obvious fix — a fixed line reading "approving and confirming happen in
 * the panels above" — would have been false in five of the eight states, since
 * the review panel renders only under `isPendingReview` and the Interac panel
 * only under `isAwaitingPayment`. A claim about a control that is not on screen
 * is the trap this repo keeps paying for, so this is derived, not written once.
 */
const decisionPanelNote = isPendingReview
  ? 'Approving or declining this request is "Review this request", above.'
  : isAwaitingPayment
    ? 'Confirming it is the customer paying, or "Mark as paid — Interac", above.'
    : null;

// ── The confirm step (BK-23 Task 7 guard rail) ─────────────────────────────
//
// The office posts `action=preview`, the route parses the typed amounts and
// bounces back here with them normalised. This block renders what the CUSTOMER
// will be quoted, computed from those exact values, and the button under it is
// the one that charges.
//
// Recomputed here rather than passed in as a total: the query string carries
// only the two figures the office typed, so a tampered or stale URL cannot
// display one number while approving another — everything shown below is
// derived, and the same two strings are what get re-parsed on approve.
const confirmRequested = Astro.url.searchParams.get('confirm') === '1';
const confirmBaseCents = parseAmountCents(Astro.url.searchParams.get('base'));
const confirmTravelCents = parseAmountCents(Astro.url.searchParams.get('travel'));
const confirming =
  confirmRequested && isPendingReview && confirmBaseCents !== null && confirmTravelCents !== null
    ? (() => {
        const subtotalCents = confirmBaseCents + confirmTravelCents;
        const gstCents = gstFor(subtotalCents);
        return {
          baseCents: confirmBaseCents,
          travelCents: confirmTravelCents,
          subtotalCents,
          gstCents,
          totalCents: subtotalCents + gstCents,
        };
      })()
    : null;

// What was actually settled, for a row past review. Without this the office can
// approve an amount and then have no screen anywhere that shows what it was.
const settled =
  appointment && appointment.assessment_amount_cents !== null
    ? {
        baseCents: appointment.assessment_amount_cents,
        travelCents: appointment.travel_fee_cents ?? 0,
        gstCents: appointment.gst_cents ?? 0,
        totalCents: appointment.total_amount_cents ?? 0,
      }
    : null;

/**
 * What the customer will be asked to pay if the office approves as suggested.
 *
 * Shown beside the fields, and it is the number that matters: the two inputs
 * are a base and a fee, and nobody approves a base — they approve a total.
 */
const suggestedDeadline =
  appointment && isPendingReview ? paymentDeadline(appointment.slot_start, new Date()) : null;

function statusClasses(status: Appointment['status']) {
  if (status === 'pending_review') return 'bg-amber-900/40 text-amber-300 border-amber-700';
  if (status === 'approved_awaiting_payment') return 'bg-amber-900/25 text-amber-200/90 border-amber-800';
  if (status === 'completed') return 'bg-green-900/40 text-green-300 border-green-800';
  if (status === 'no_show') return 'bg-red-900/40 text-red-300 border-red-800';
  if (status === 'cancelled' || status === 'declined' || status === 'payment_expired') {
    return 'bg-zinc-800 text-zinc-500 border-zinc-700';
  }
  return 'bg-blue-900/40 text-blue-300 border-blue-800';
}
---

<AdminLayout title={appointment ? `${appointment.name} — Appointment` : 'Appointment'}>
  <div class="mb-5">
    <a href={ADMIN_APPOINTMENTS_PATH} class="text-zinc-500 hover:text-zinc-300 text-sm transition-colors">
      ← All Appointments
    </a>
  </div>

  {flashes.map(flash => (
    <div
      class={`rounded-lg px-4 py-3 text-sm mb-5 border ${
        flash.tone === 'ok'
          ? 'bg-green-900/30 border-green-800 text-green-300'
          : 'bg-amber-900/30 border-amber-800/70 text-amber-200'
      }`}
    >
      {flash.text}
    </div>
  ))}

  {/*
    MONEY LANDED SOMEWHERE IT SHOULD NOT HAVE (BK-32).

    Above everything, in red, and unmissable. `needs_attention` is written by
    `markPaid()` and the webhook for the cases nobody can automate away: a
    double payment, a payment that arrived after the slot was released, an
    amount Stripe charged that disagrees with what was approved, a Checkout
    Session that outlived its row. Every one of them is a customer with money
    gone and a human decision to make.

    NOTHING CLEARS IT, which is BK-32's scope decision rather than an
    oversight: an acknowledge-and-clear action is separate admin UX. It appends,
    so a second problem on the same row never overwrites the first.
  */}
  {appointment?.needs_attention && (
    <div class="bg-red-950/60 border-2 border-red-700 rounded-lg px-4 py-3 mb-5">
      <h2 class="text-red-300 font-semibold text-sm mb-1">Payment needs attention</h2>
      <p class="text-red-200/90 text-sm whitespace-pre-line">{appointment.needs_attention}</p>
      <p class="text-red-300/70 text-xs mt-2">
        Nothing has been refunded automatically. Issue any refund by hand in the Stripe dashboard.
      </p>
    </div>
  )}

  {dbError && (
    <div class="bg-red-900/30 border border-red-800 rounded-lg px-4 py-3 text-red-300 text-sm">{dbError}</div>
  )}

  {appointment && (
    <div class="space-y-5">
      <!-- Visit -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <div class="flex items-start justify-between gap-4 mb-5">
          <div>
            <h1 class="text-white text-xl font-bold">{formatSlot(appointment.slot_start)}</h1>
            <p class="text-zinc-500 text-xs mt-1">
              {TIMEZONE_NOTE} · {appointment.duration_minutes} minutes · booking #{appointment.id}
            </p>
          </div>
          <span class={`inline-flex items-center px-2.5 py-1 rounded text-xs font-medium border shrink-0 ${statusClasses(appointment.status)}`}>
            {STATUS_LABELS[appointment.status]}
          </span>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Service</dt>
            <dd class="text-white">{SERVICE_LABELS[appointment.service] ?? appointment.service}</dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Assessment</dt>
            <dd class="text-white">
              {appointment.assessment_tier ? (
                <>
                  {ASSESSMENT_TIER_NAMES[appointment.assessment_tier]}
                  <span class="text-zinc-400"> · {formatCents(quote!.baseCents)} + GST</span>
                  <span class="block text-zinc-500 text-xs mt-0.5">
                    {formatCents(quote!.totalCents)} total incl. GST
                    {quote!.afterHours ? ' · weekend rate, 1.5×' : ''}
                  </span>
                </>
              ) : (
                <span class="text-zinc-500">Not chosen — phone booking, settle with the customer</span>
              )}
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Pipeline stage</dt>
            <dd class="text-white">{PIPELINE_STAGE_LABELS[appointment.pipeline_stage]}</dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Payment route</dt>
            <dd class="text-white">{PAYMENT_ROUTE_LABELS[appointment.payment_route]}</dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Source</dt>
            <dd class="text-white">{appointment.source === 'admin' ? 'Entered by office' : 'Booked online'}</dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Booked</dt>
            <dd class="text-white">{formatAdminTimestamp(appointment.created_at)}</dd>
          </div>
          {appointment.cancelled_at && (
            <div>
              <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Cancelled</dt>
              <dd class="text-red-300">{formatAdminTimestamp(appointment.cancelled_at)}</dd>
            </div>
          )}
        </dl>
      </div>

      <!-- Customer -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <h2 class="text-white font-semibold mb-4">Customer</h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Name</dt>
            <dd class="text-white">{appointment.name}</dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Phone</dt>
            <dd class="text-white">
              <a href={`tel:${appointment.phone}`} class="hover:text-amber-400 transition-colors">{appointment.phone}</a>
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Email</dt>
            <dd class="text-white">
              {appointment.email
                ? <a href={`mailto:${appointment.email}`} class="hover:text-amber-400 transition-colors">{appointment.email}</a>
                : <span class="text-zinc-600">Not provided</span>
              }
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Address</dt>
            <dd class="text-white">
              {appointment.address}<br />
              {appointment.city}{appointment.postal_code ? ` ${appointment.postal_code}` : ''}
            </dd>
          </div>
          {appointment.description && (
            <div class="sm:col-span-2">
              <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">What happened</dt>
              <dd class="text-white whitespace-pre-wrap bg-zinc-800/50 rounded-lg p-3 text-sm leading-relaxed">
                {appointment.description}
              </dd>
            </div>
          )}
        </dl>
      </div>

      <!--
        Insurance — the sanctioned admin surface for these identifiers
        (002-booking: "email and the admin panel only"). Absent entirely on the
        private route, rather than rendered empty.
      -->
      {appointment.payment_route === 'insurance' && (
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
          <h2 class="text-white font-semibold mb-4">Insurance</h2>
          <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
            <div>
              <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Insurer</dt>
              <dd class="text-white">{appointment.insurer_name ?? <span class="text-zinc-600">Not provided</span>}</dd>
            </div>
            <div>
              <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Policy number</dt>
              <dd class="text-white font-mono text-xs">{appointment.policy_number ?? <span class="text-zinc-600 font-sans text-sm">Not provided</span>}</dd>
            </div>
            <div>
              <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Claim number</dt>
              <dd class="text-white font-mono text-xs">{appointment.claim_number ?? <span class="text-zinc-600 font-sans text-sm">Not provided</span>}</dd>
            </div>
          </dl>
        </div>
      )}

      <!--
        Notifications. The two BK-05 stamps are the only ones that can be a
        FAILURE; consent and reminder are neutral states by design — a null
        consent is "no consent" (the timestamp is the consent), and a null
        reminder is expected on every row until BK-06 ships.

        BK-08 added a third neutral state, "None sent": an office-entered row
        with an email address may simply not have been sent one — the box was
        unticked, or the send failed — and "Not applicable" would now be a lie.
        Which of those it was is not recorded; the resend button recovers both.
      -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <div class="flex items-start justify-between gap-4 mb-4">
          <h2 class="text-white font-semibold">Notifications</h2>
          {canResend && (
            <form method="POST" action={ADMIN_APPOINTMENT_RESEND_ENDPOINT} class="shrink-0">
              <input type="hidden" name="id" value={String(appointment.id)} />
              <button
                type="submit"
                class="border border-amber-700/60 text-amber-300 hover:bg-amber-900/30 text-xs font-medium rounded-lg px-3 py-1.5 transition-colors"
              >
                {appointment.confirmation_sent_at ? 'Resend confirmation' : 'Send confirmation'}
              </button>
            </form>
          )}
        </div>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Office notified</dt>
            <dd>
              {internalStamp === 'sent' ? (
                <span class="text-white">{formatAdminTimestamp(appointment.internal_notified_at!)}</span>
              ) : internalStamp === 'failed' ? (
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border bg-red-900/40 text-red-300 border-red-800">
                  Never sent — the office was not told
                </span>
              ) : (
                <span class="text-zinc-600">Not applicable</span>
              )}
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Customer confirmation</dt>
            <dd>
              {customerStamp === 'sent' ? (
                <span class="text-white">{formatAdminTimestamp(appointment.confirmation_sent_at!)}</span>
              ) : customerStamp === 'failed' ? (
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border bg-amber-900/30 text-amber-300 border-amber-800/70">
                  Never sent
                </span>
              ) : customerStamp === 'none' ? (
                <span class="text-zinc-500">None sent</span>
              ) : (
                <span class="text-zinc-600">Not applicable</span>
              )}
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">SMS consent</dt>
            <dd class="text-white">
              {appointment.sms_consent_at
                ? formatAdminTimestamp(appointment.sms_consent_at)
                : <span class="text-zinc-500">No consent</span>
              }
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Assessment terms</dt>
            <dd class="text-white">
              {appointment.terms_acked_at
                ? formatAdminTimestamp(appointment.terms_acked_at)
                : appointment.source === 'admin'
                  ? <span class="text-zinc-500">Exempt — office entry</span>
                  /*
                    "Not recorded", not "Not acknowledged". A web row cannot
                    reach this arm once BK-27 is deployed — the endpoint refuses
                    the booking — so the only rows that ever show it are the
                    handful that predate migration 005. "Not acknowledged" reads
                    as a customer who refused; they were never asked.
                  */
                  : <span class="text-zinc-500">Not recorded — predates the terms</span>
              }
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Reminder</dt>
            <dd class="text-white">
              {appointment.reminder_sent_at
                ? formatAdminTimestamp(appointment.reminder_sent_at)
                : <span class="text-zinc-500">Not sent</span>
              }
            </dd>
          </div>
        </dl>
      </div>

      <!--
        Files. The Blob store is private and enforces it at the store level, so
        a direct URL here would 403 — each name links to the authenticated proxy
        instead, which 302s to a signed URL that dies after a few minutes.
        Pathnames and URLs are still not rendered even as text: the link carries
        the row id and nothing else.

        Pending rows render unlinked. Their bytes may not exist yet — the
        upload-completed webhook never fires against localhost — and a link that
        opens a CDN 404 is worse than no link. The ROUTE does not 404 them; this
        is presentation.
      -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <h2 class="text-white font-semibold mb-1">
          Files <span class="text-zinc-600 font-normal text-sm">({liveFiles.length})</span>
        </h2>
        <p class="text-zinc-600 text-xs mb-4">
          Links open in a new tab and expire after a few minutes. Click again for a fresh one.
        </p>

        {liveFiles.length === 0 ? (
          <p class="text-zinc-600 text-sm">No files attached.</p>
        ) : (
          <ul class="divide-y divide-zinc-800/60 text-sm">
            {liveFiles.map(file => (
              <li class="py-3 flex items-start justify-between gap-4">
                <span class="min-w-0">
                  {file.upload_state === 'pending' ? (
                    <span class="block text-zinc-400 truncate">{file.original_name ?? 'Unnamed file'}</span>
                  ) : (
                    <a
                      href={adminFilePath(file.id)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="block text-amber-400 hover:text-amber-300 truncate transition-colors"
                    >
                      {file.original_name ?? 'Unnamed file'}
                    </a>
                  )}
                  <span class="block text-zinc-500 text-xs mt-0.5">
                    {formatFileSize(file.size_bytes)}
                    {' · '}{FILE_SOURCE_LABELS[file.source ?? 'unrecorded']}
                    {' · '}{formatAdminTimestamp(file.created_at)}
                    {file.upload_state === 'pending' && ' · upload not confirmed'}
                  </span>
                </span>

                <!--
                  A POST, never a link. A GET that deletes is a file removed by
                  whatever prefetches the page — the same reasoning P7 wrote
                  down for the approve/decline buttons, and it applies to any
                  mutation reachable from a URL.

                  No confirm() dialog: the action is soft and reversible in the
                  database, and a blocking dialog on every removal costs the
                  office more than the occasional mis-click does.
                -->
                <form
                  method="POST"
                  action={ADMIN_APPOINTMENT_FILE_DELETE_ENDPOINT}
                  class="shrink-0 flex items-center gap-2"
                >
                  <input type="hidden" name="id" value={String(file.id)} />
                  <input
                    type="text"
                    name="note"
                    maxlength={MAX_FILE_DELETE_NOTE}
                    placeholder="Why? (optional)"
                    aria-label={`Reason for removing ${file.original_name ?? 'this file'}`}
                    class="w-32 bg-zinc-950 border border-zinc-800 rounded px-2 py-1 text-xs text-zinc-300 placeholder-zinc-700 focus:border-amber-500 focus:outline-none"
                  />
                  <button
                    type="submit"
                    class="border border-zinc-700 text-zinc-400 hover:text-red-300 hover:border-red-800 text-xs rounded px-2 py-1 transition-colors"
                  >
                    Remove
                  </button>
                </form>
              </li>
            ))}
          </ul>
        )}

        <!--
          Removed files stay visible, muted and unlinked. The office needs to
          see THAT something was removed and why — "the customer says they sent
          four photos" is answerable from this list and from nowhere else. The
          row is not a link: `claimedFilePathname` refuses a deleted id, so a
          link here would 404 by design.
        -->
        {deletedFiles.length > 0 && (
          <div class="mt-5 pt-4 border-t border-zinc-800/60">
            <p class="text-zinc-600 text-xs uppercase tracking-wide mb-2">
              Removed ({deletedFiles.length})
            </p>
            <ul class="space-y-2 text-sm">
              {deletedFiles.map(file => (
                <li class="text-zinc-600">
                  <span class="line-through">{file.original_name ?? 'Unnamed file'}</span>
                  <span class="block text-xs mt-0.5">
                    removed {formatAdminTimestamp(file.deleted_at!)}
                    {file.deleted_note ? ` — ${file.deleted_note}` : ''}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!--
        BK-34a. Getting photos onto a PHONE booking, which until now was
        impossible — they arrived in somebody's inbox and stayed there.

        Two arms, one capability:

          - the link, which the office texts (BK-34b sends it automatically once
            the Twilio number is live; until then this is copy-paste);
          - the same uploader inline, for an agent who already has the files.

        The inline arm is why there is no multipart proxy in this feature. A
        100 MB video posted through a serverless function is the shape
        `booking-files.ts` rejects on the read side, and it would be a second
        upload path to keep correct. This one is the customer's path, running
        under a token the page just minted.
      -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <h2 class="text-white font-semibold mb-1">Get photos</h2>
        <p class="text-zinc-600 text-xs mb-5">
          Text the customer this link, or add files yourself if they emailed them.
        </p>

        {uploadLink ? (
          <>
            <label class="block text-zinc-400 text-xs uppercase tracking-wide mb-1.5" for="upload-link">
              Upload link
            </label>
            <input
              id="upload-link"
              type="text"
              readonly
              value={uploadLink}
              onfocus="this.select()"
              class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-xs text-zinc-300 font-mono focus:border-amber-500 focus:outline-none"
            />

            <!--
              BK-37. Until the Twilio number clears (BK-34b), the office agent's
              own phone IS the SMS gateway, which makes this row the delivery
              mechanism rather than a convenience.

              THE BUTTONS ARE RENDERED BY SCRIPT, NOT BY THE SERVER, and that is
              the point: `navigator.share` exists on the agent's phone and not
              on the desk machine, and which one is in front of the link is not
              knowable at build time. A server-rendered Share button that does
              nothing on a desktop is worse than no button — the agent taps it,
              nothing happens, and they stop trusting the row. The fallbacks are
              in the markup and Share is added to them when the API is really
              there; a browser with no JS at all keeps the readonly field, which
              is what the office had before this ticket.
            -->
            <div
              id="upload-link-actions"
              class="flex flex-wrap items-center gap-2 mt-2"
              data-link={uploadLink}
              data-message={`Send us photos or video of the damage here: ${uploadLink}`}
            >
              <button
                type="button"
                data-action="copy"
                class="border border-zinc-700 text-zinc-200 hover:bg-zinc-800 text-xs font-medium rounded-lg px-3 py-1.5 transition-colors"
              >
                Copy link
              </button>
              <a
                data-action="whatsapp"
                href={`https://wa.me/?text=${encodeURIComponent(`Send us photos or video of the damage here: ${uploadLink}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="border border-zinc-700 text-zinc-200 hover:bg-zinc-800 text-xs font-medium rounded-lg px-3 py-1.5 transition-colors"
              >
                WhatsApp
              </a>
              <span data-role="status" class="text-xs text-emerald-400" role="status" aria-live="polite"></span>
            </div>

            <!--
              The expiry, stated absolutely rather than as "expires in 43h".
              A countdown would be a lie on this page: the token is re-minted on
              every view (see above), so the number would read 72h every single
              time and tell the office nothing about the link they texted on
              Tuesday.

              The second sentence is there because the first invites the wrong
              inference. Tokens are stateless HMACs with no revocation — opening
              this page does NOT kill the link already in a customer's messages,
              and an office that believes it does will re-send a link nobody
              needed and leave a live one they think is dead.
            -->
            {uploadExpiresAt && (
              <p class="text-zinc-500 text-xs mt-3 mb-6 leading-relaxed">
                This link works until <span class="text-zinc-300">{formatAdminTimestamp(uploadExpiresAt)}</span>.
                A fresh link is made each time you open this page; links you have already sent keep
                working until their own {APPOINTMENT_UPLOAD_TTL_HOURS} hours are up.
              </p>
            )}

            <p class="text-zinc-400 text-xs uppercase tracking-wide mb-2">Or add files here</p>
            <AppointmentUpload
              client:load
              token={officeToken!}
              draftId={officeDraftId!}
              variant="admin"
            />
          </>
        ) : (
          <p class="text-zinc-500 text-sm">
            Upload links are unavailable — BOOKING_DRAFT_SECRET is not configured.
          </p>
        )}
      </div>

      <!--
        The edit form. Status, stage and notes in ONE submit, because they are
        one UPDATE: a status change that collides rolls the whole statement
        back, and splitting the form would imply the notes survived when they
        did not.

        Cancelling is just the status select — there is no separate destructive
        button, and cancelling never deletes the row. Rescheduling is not here:
        it is cancel + re-enter (see the ticket's Out of scope).
      -->
      <!--
        THE REVIEW PANEL (BK-23). Only for `pending_review`, and it posts to its
        own route rather than to the update form's.

        The separation is deliberate and it is a safety property, not tidiness.
        `update.ts` is a whitelist editor: it sets a status and nothing else.
        Approving has to compute a deadline, snapshot four amounts and send the
        customer a message they will act on — so if the status dropdown could
        also produce `approved_awaiting_payment`, the office would be one
        careless selection away from an approved booking with no amount, no
        deadline and no email.

        IT COULD, UNTIL BK-44, and this comment said otherwise. The stated
        reason — "`review.ts` is the only path that performs the transition, and
        it guards on `status = 'pending_review'`" — described `review.ts`
        correctly and said nothing at all about `update.ts`, which rendered all
        eight statuses and guarded none. A separation is only a safety property
        if BOTH sides enforce it. `update.ts` now does, from the same rule this
        dropdown renders (`editorStatusTargets`), and the guard is in its WHERE
        clause rather than in a template.
      -->
      {/*
        WHAT WAS SETTLED, for a row past review.
        <br />
        Without this the office could approve an amount and then have no screen
        anywhere that showed what it was — `assessment_amount_cents` and its
        siblings were written by the approval and read by nothing. The figure a
        customer is disputing has to be visible to the person taking the call.
      */}
      {settled && (
        <section class="bg-zinc-900 border border-zinc-800 rounded-xl p-6 mb-6">
          <h2 class="text-white font-semibold mb-1">Amount settled at approval</h2>
          <p class="text-zinc-500 text-xs mb-4">
            Snapshotted when this was approved — not recomputed from today's prices.
          </p>
          <dl class="text-sm max-w-sm">
            <div class="flex justify-between gap-4 py-1.5 border-b border-zinc-800">
              <dt class="text-zinc-400">Assessment</dt>
              <dd class="text-zinc-200">{formatCents(settled.baseCents)}</dd>
            </div>
            <div class="flex justify-between gap-4 py-1.5 border-b border-zinc-800">
              <dt class="text-zinc-400">Travel</dt>
              <dd class="text-zinc-200">{formatCents(settled.travelCents)}</dd>
            </div>
            <div class="flex justify-between gap-4 py-1.5 border-b border-zinc-800">
              <dt class="text-zinc-400">GST (5%)</dt>
              <dd class="text-zinc-200">{formatCents(settled.gstCents)}</dd>
            </div>
            <div class="flex justify-between gap-4 py-2.5 font-semibold">
              <dt class="text-white">Total</dt>
              <dd class="text-white">{formatCents(settled.totalCents)}</dd>
            </div>
          </dl>
          {appointment.payment_due_at && (
            <p class="text-zinc-500 text-xs mt-3">
              Payment due by {formatSlot(appointment.payment_due_at)} ({TIMEZONE_NOTE}).
            </p>
          )}
        </section>
      )}

      {/*
        "MARK AS PAID — INTERAC" (BK-32).

        The office reading their own inbox and asserting that an e-Transfer
        arrived. There is no inbox parsing and no auto-matching anywhere in this
        system, deliberately — which is exactly why this button records WHO said
        so and WHEN: it is a human claim about money, so it needs an author.

        THE AMOUNT IS NOT A FIELD. The office is asserting that the amount the
        approval settled arrived, and giving them a box to type a different one
        would make this screen a second place money is decided. BK-23's whole
        approval design exists so that there is exactly one. A partial payment
        is a conversation, not a form field.

        Everything this does happens inside `markPaid()` — the same function the
        Stripe webhook calls. One transition, one confirmation email, one ics,
        so a booking paid by e-Transfer and one paid by card are
        indistinguishable afterwards, and whichever payment arrives second
        no-ops and flags rather than confirming twice.
      */}
      {isAwaitingPayment && (
        <form
          method="POST"
          action={ADMIN_APPOINTMENT_MARK_PAID_ENDPOINT}
          class="bg-zinc-900 border border-zinc-800 rounded-xl p-6 mb-6"
        >
          <input type="hidden" name="id" value={String(appointment.id)} />

          <h2 class="text-white font-semibold mb-1">Payment</h2>
          <p class="text-zinc-500 text-xs mb-4">
            Waiting on {settled ? formatCents(settled.totalCents) : 'payment'}
            {appointment.payment_due_at
              ? ` by ${formatSlot(appointment.payment_due_at)} (${TIMEZONE_NOTE})`
              : ' — pay-now booking, no deadline. Chase it by phone.'}.
            {appointment.stripe_session_id
              ? ' A card link has been sent.'
              : ' No card link was created; the customer has the e-Transfer details.'}
          </p>

          <label class="block text-zinc-400 text-xs mb-1" for="interac-reference">
            e-Transfer reference <span class="text-zinc-600">(optional)</span>
          </label>
          <input
            id="interac-reference"
            type="text"
            name="reference"
            maxlength="200"
            placeholder="Reference number from the e-Transfer notice"
            class="w-full max-w-sm bg-zinc-950 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-100 mb-1"
          />
          {/*
            Optional, and that is deliberate. Requiring it would push somebody
            into inventing one, and an invented reference is worse than none:
            the reference is what tells a redelivered payment from a genuinely
            second one, so a fabricated value turns a silent no-op into a false
            "double payment — issue a refund" alert.
          */}
          <p class="text-zinc-600 text-xs mb-4">
            Helps tell one payment arriving twice from two real payments. Leave it blank if you do
            not have it.
          </p>

          <label class="block text-zinc-400 text-xs mb-1" for="interac-actor">Your name</label>
          <input
            id="interac-actor"
            type="text"
            name="actor"
            maxlength="120"
            placeholder="Who is confirming this"
            class="w-full max-w-sm bg-zinc-950 border border-zinc-700 rounded-lg px-3 py-2 text-sm text-zinc-100 mb-4"
          />

          <button
            type="submit"
            class="bg-green-600 hover:bg-green-500 text-white font-semibold text-sm rounded-lg px-5 py-2.5 transition-colors"
          >
            Mark as paid — Interac
          </button>
          <p class="text-zinc-600 text-xs mt-3">
            This confirms the booking and sends the customer their confirmation and calendar
            invite. If they have already paid the card link, this will say so and change nothing.
          </p>
        </form>
      )}

      {/*
        THE CONFIRM STEP. Rendered from the amounts the office actually typed,
        server-side, with no script keeping it honest — see `isReviewAction`'s
        note for why this is a round trip rather than a live field.

        The button in here is the one that charges. Everything above it is the
        same itemisation the customer receives, in the same order, so what is
        approved and what is quoted cannot be two different numbers.
      */}
      {confirming && (
        <form
          method="POST"
          action={ADMIN_APPOINTMENT_REVIEW_ENDPOINT}
          class="bg-zinc-900 border border-amber-500 rounded-xl p-6 mb-6"
        >
          <input type="hidden" name="id" value={String(appointment.id)} />
          {/*
            The SAME strings the route just normalised, re-posted into the same
            fields `approve` parses. The office confirms a number produced by
            one parser and that same parser produces the number charged.
          */}
          <input type="hidden" name="assessment_amount" value={amountField(confirming.baseCents)} />
          <input type="hidden" name="travel_fee" value={amountField(confirming.travelCents)} />

          <h2 class="text-white font-semibold mb-1">Confirm the amount</h2>
          <p class="text-zinc-500 text-xs mb-5">
            This is what {appointment.name} will be asked to pay. Nothing has been sent yet.
          </p>

          <dl class="text-sm mb-5 max-w-sm">
            <div class="flex justify-between gap-4 py-1.5 border-b border-zinc-800">
              <dt class="text-zinc-400">Assessment</dt>
              <dd class="text-zinc-200">{formatCents(confirming.baseCents)}</dd>
            </div>
            <div class="flex justify-between gap-4 py-1.5 border-b border-zinc-800">
              <dt class="text-zinc-400">Travel</dt>
              <dd class="text-zinc-200">{formatCents(confirming.travelCents)}</dd>
            </div>
            <div class="flex justify-between gap-4 py-1.5 border-b border-zinc-800">
              <dt class="text-zinc-400">GST (5%)</dt>
              <dd class="text-zinc-200">{formatCents(confirming.gstCents)}</dd>
            </div>
            <div class="flex justify-between gap-4 py-2.5 font-semibold">
              <dt class="text-white">Total</dt>
              <dd class="text-amber-400">{formatCents(confirming.totalCents)}</dd>
            </div>
          </dl>

          <div class="flex flex-wrap gap-3 items-center">
            <button
              type="submit"
              name="action"
              value="approve"
              class="bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold text-sm rounded-lg px-5 py-2.5 transition-colors"
            >
              Approve and send — {formatCents(confirming.totalCents)}
            </button>
            <a
              href={adminAppointmentPath(appointment.id)}
              class="text-zinc-400 hover:text-zinc-200 text-sm underline underline-offset-4"
            >
              Change the amounts
            </a>
          </div>
        </form>
      )}

      {isPendingReview && (
        <form
          method="POST"
          action={ADMIN_APPOINTMENT_REVIEW_ENDPOINT}
          class="bg-zinc-900 border border-amber-800/60 rounded-xl p-6 mb-6"
        >
          <input type="hidden" name="id" value={String(appointment.id)} />
          <h2 class="text-white font-semibold mb-1">Review this request</h2>
          <p class="text-zinc-500 text-xs mb-5">
            The time is held while this sits here. Approving emails the customer an
            amount, a deadline and how to pay; declining releases the slot and tells
            them we are at capacity.
          </p>

          {appointment.assessment_tier && suggestedQuote ? (
            <>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
                <div>
                  <label class="block text-zinc-400 text-xs uppercase tracking-wide mb-1.5" for="assessment_amount">
                    Assessment ($)
                  </label>
                  <input
                    type="text"
                    inputmode="decimal"
                    id="assessment_amount"
                    name="assessment_amount"
                    value={amountField(suggestedQuote.baseCents)}
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-amber-500 focus:outline-none"
                  />
                  <p class="text-zinc-600 text-xs mt-1.5">
                    {ASSESSMENT_TIER_NAMES[appointment.assessment_tier]}
                    {suggestedQuote.afterHours ? ' · weekend rate, 1.5× applied' : ''}
                  </p>
                </div>
                <div>
                  <label class="block text-zinc-400 text-xs uppercase tracking-wide mb-1.5" for="travel_fee">
                    Travel fee ($)
                  </label>
                  <input
                    type="text"
                    inputmode="decimal"
                    id="travel_fee"
                    name="travel_fee"
                    value="0.00"
                    class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-amber-500 focus:outline-none"
                  />
                  {/*
                    The rule, not a computed number. There is no distance API in
                    this infrastructure and the client asked not to block on
                    adding one, so the office reads the rule, uses the
                    directions link above, and types the figure. Never applied
                    automatically — the field defaults to zero.
                  */}
                  <p class="text-zinc-600 text-xs mt-1.5">
                    ${(TRAVEL_FEE_CENTS_PER_KM / 100).toFixed(2)}/km round trip beyond {TRAVEL_FEE_FREE_RADIUS_KM} km. Leave at 0 if none.
                  </p>
                </div>
              </div>

              <p class="text-zinc-400 text-sm mb-1">
                GST and the total are worked out from these — there is no field for either.
              </p>
              {/*
                NO TOTAL HERE, deliberately. This panel used to print one from
                the suggestion, which stopped being true the moment either field
                was edited — correct only in the case where it did not matter.
                The itemised figure now lives on the confirm step below, where it
                is computed from what was actually typed.
              */}
              <p class="text-zinc-500 text-xs mb-4">
                Suggested {formatCents(suggestedQuote.baseCents)} before GST. You will see the
                itemised total, as the customer gets it, before anything is sent.
                {suggestedDeadline && suggestedDeadline.dueAt
                  ? ` Payment due by ${formatSlot(suggestedDeadline.dueAt)} (${TIMEZONE_NOTE}).`
                  : ' This slot is close, so the link will be sent to be paid right away rather than on a deadline.'}
              </p>

              <div class="flex flex-wrap gap-3">
                <button
                  type="submit"
                  name="action"
                  value="preview"
                  class="bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold text-sm rounded-lg px-5 py-2.5 transition-colors"
                >
                  Review the amount →
                </button>
                <button
                  type="submit"
                  name="action"
                  value="decline"
                  class="border border-zinc-700 hover:border-zinc-500 text-zinc-300 font-semibold text-sm rounded-lg px-5 py-2.5 transition-colors"
                >
                  Decline — at capacity
                </button>
              </div>
            </>
          ) : (
            <>
              {/*
                No tier means no amount to charge, so approval is impossible
                rather than merely awkward. Declining still works — a request
                the office cannot price is one they may well want to turn down.
              */}
              <p class="text-amber-300/90 text-sm mb-4">
                This booking has no assessment chosen, so there is no amount to charge.
                Set one under Update the record below, then approve.
              </p>
              <button
                type="submit"
                name="action"
                value="decline"
                class="border border-zinc-700 hover:border-zinc-500 text-zinc-300 font-semibold text-sm rounded-lg px-5 py-2.5 transition-colors"
              >
                Decline — at capacity
              </button>
            </>
          )}
        </form>
      )}

      <form method="POST" action={ADMIN_APPOINTMENT_UPDATE_ENDPOINT} class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <input type="hidden" name="id" value={String(appointment.id)} />
        <h2 class="text-white font-semibold mb-1">Update the record</h2>
        {/*
          BK-44. The heading and this line exist to say what this panel is NOT.
          The office member who found the defect found it by asking which of the
          two panels accepts a booking — the right question, and one the page
          did not answer.
        */}
        <p class="text-zinc-600 text-xs mb-1">
          Record-keeping, not a decision.{decisionPanelNote ? ` ${decisionPanelNote}` : ''}
        </p>
        {/*
          UN-CANCELLING NOW HAS TWO FAILURE CAUSES, and this sentence asserted
          one. BK-44 added the second: a booking that was never paid cannot
          cross back into the invite-holding set, so it returns as a request
          rather than as a confirmed visit. The withheld-status line under the
          dropdown explains that for the row on screen; this line describes the
          operation, and describing it by one of its two causes is how a true
          sentence becomes a misleading one.
        */}
        <p class="text-zinc-600 text-xs mb-5">
          Cancelling frees the slot for online booking but keeps the record. Un-cancelling
          fails if somebody has taken the slot since, and a booking that was never paid comes
          back as a request rather than as a confirmed visit.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
          <div>
            <label class="block text-zinc-400 text-xs uppercase tracking-wide mb-1.5" for="status">Status</label>
            <select
              id="status"
              name="status"
              class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-amber-500 focus:outline-none"
            >
              {/*
                BK-44. The statuses this row may legally move to, NOT all eight.
                `editorStatusTargets` is the same function `update.ts`'s WHERE
                clause is transcribed from, re-exported rather than redeclared —
                so an option that appears here is one the server will accept,
                and one that does not appear is one it would refuse.

                THIS IS PRESENTATION, NOT THE GUARD. A template-only fix is a
                client-side check on a write path; the route refuses regardless,
                and the pins prove the refusal at the route rather than here.

                The current status is always among the options, by contract —
                a select that omits its own value submits the FIRST option
                instead, which would silently un-approve a booking every time
                somebody saved a note on it.
              */}
              {statusTargets.map(value => (
                <option value={value} selected={value === appointment.status}>
                  {STATUS_LABELS[value]}
                </option>
              ))}
            </select>
            {/*
              A missing option must read as "routed elsewhere", not as broken.
              Both sentences are derived from what is actually withheld for THIS
              row, so neither can claim something the state does not support.
            */}
            {decisionWithheld.length > 0 && (
              <p class="text-zinc-600 text-xs mt-1.5">
                Not listed: {decisionWithheld.map(s => STATUS_LABELS[s]).join(', ')}. That comes
                from approving{isPendingReview ? ', in “Review this request” above' : ''}.
              </p>
            )}
            {untilPaidWithheld.length > 0 && (
              <p class="text-zinc-600 text-xs mt-1.5">
                Not listed until this booking is paid:{' '}
                {untilPaidWithheld.map(s => STATUS_LABELS[s]).join(', ')}.
              </p>
            )}
            {reopenWithheld && (
              <p class="text-zinc-600 text-xs mt-1.5">
                This cannot be reopened while its payment link is live — the customer could still
                pay it. Decline or cancel instead.
              </p>
            )}
          </div>
          <div>
            <label class="block text-zinc-400 text-xs uppercase tracking-wide mb-1.5" for="pipeline_stage">
              Pipeline stage
            </label>
            <select
              id="pipeline_stage"
              name="pipeline_stage"
              class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-amber-500 focus:outline-none"
            >
              {PIPELINE_STAGES.map(value => (
                <option value={value} selected={value === appointment.pipeline_stage}>
                  {PIPELINE_STAGE_LABELS[value]}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="mb-5">
          <label class="block text-zinc-400 text-xs uppercase tracking-wide mb-1.5" for="assessment_tier">
            Assessment
          </label>
          <select
            id="assessment_tier"
            name="assessment_tier"
            class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-amber-500 focus:outline-none"
          >
            <option value="" selected={appointment.assessment_tier === null}>Not chosen</option>
            {ASSESSMENT_TIERS.map(value => (
              <option value={value} selected={value === appointment.assessment_tier}>
                {ASSESSMENT_TIER_NAMES[value]}
              </option>
            ))}
          </select>
          {/*
            BK-31. The office must be able to change this when a customer
            upgrades on site — and must be told what changing it does NOT do.
            Under P9 this row may already have been paid against, and an edit
            that silently looked like it triggered a charge is how somebody gets
            billed twice.
          */}
          <p class="text-zinc-500 text-xs mt-1.5">
            Changing this does not charge anything. Collect any difference on site or add it to the invoice.
          </p>
        </div>

        <div class="mb-5">
          <label class="block text-zinc-400 text-xs uppercase tracking-wide mb-1.5" for="admin_notes">
            Office notes
          </label>
          <textarea
            id="admin_notes"
            name="admin_notes"
            rows="4"
            maxlength={MAX_STORED_ADMIN_NOTES}
            class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white placeholder-zinc-600 focus:border-amber-500 focus:outline-none"
            placeholder="Internal only — never sent to the customer."
          >{appointment.admin_notes ?? ''}</textarea>
        </div>

        <button
          type="submit"
          class="bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold text-sm rounded-lg px-5 py-2.5 transition-colors"
        >
          Save changes
        </button>
      </form>
    </div>
  )}
</AdminLayout>

<script>
  /**
   * BK-37 — getting the upload link out of this page and into a text message.
   *
   * Three behaviours, feature-detected in this order:
   *
   *   1. **Share**, added only when `navigator.share` is really present. On the
   *      agent's phone this opens the OS share sheet, which is the one route to
   *      Messages, WhatsApp and mail without the office retyping anything. It
   *      is added by script rather than rendered by the server because the
   *      server cannot know which device is asking, and a Share button that
   *      does nothing on a desk machine trains the agent to distrust the row.
   *   2. **Copy**, which needs `navigator.clipboard` — HTTPS or localhost only.
   *      When that is missing (an office on plain HTTP over a LAN, say) the
   *      button selects the field instead and says so, which still gets the
   *      link into the clipboard with one keystroke rather than failing mute.
   *   3. **WhatsApp**, a plain anchor in the markup. It is the desktop
   *      fallback, it needs no JS at all, and `wa.me` with no number opens the
   *      contact picker.
   *
   * `share()` rejects with an `AbortError` when the user dismisses the sheet.
   * That is a normal outcome, not a failure, and must not be reported as one —
   * a red "Could not share" on every dismissed sheet is how a working button
   * gets reported as broken.
   */
  const actions = document.getElementById('upload-link-actions');
  const field = document.getElementById('upload-link') as HTMLInputElement | null;

  if (actions && field) {
    const url = actions.dataset.link ?? '';
    const message = actions.dataset.message ?? url;
    const status = actions.querySelector<HTMLElement>('[data-role="status"]');

    let clearAt: ReturnType<typeof setTimeout> | undefined;
    const say = (text: string, ok = true) => {
      if (!status) return;
      status.textContent = text;
      status.className = `text-xs ${ok ? 'text-emerald-400' : 'text-amber-400'}`;
      clearTimeout(clearAt);
      clearAt = setTimeout(() => (status.textContent = ''), 4000);
    };

    actions.querySelector('[data-action="copy"]')?.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard) throw new Error('no clipboard api');
        await navigator.clipboard.writeText(url);
        say('Link copied.');
      } catch {
        // Not a dead end: the field is still right there, and selecting it
        // leaves the agent one Ctrl-C away instead of nowhere.
        field.focus();
        field.select();
        say('Selected the link — press Ctrl/Cmd + C to copy.', false);
      }
    });

    if (typeof navigator.share === 'function') {
      const share = document.createElement('button');
      share.type = 'button';
      share.textContent = 'Share';
      share.className =
        'border border-amber-700/60 text-amber-300 hover:bg-amber-900/30 text-xs font-medium rounded-lg px-3 py-1.5 transition-colors';
      share.addEventListener('click', async () => {
        try {
          // `text` and `url` both, not `url` alone: several share targets drop
          // a bare URL into an empty message with no explanation of what the
          // customer is being asked to do.
          await navigator.share({ text: message, url });
        } catch (err) {
          // A dismissed share sheet is an AbortError and is not a failure.
          if ((err as DOMException)?.name !== 'AbortError') {
            say('Could not open the share sheet — copy the link instead.', false);
          }
        }
      });
      actions.prepend(share);
    }
  }
</script>
