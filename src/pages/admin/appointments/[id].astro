---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import {
  ADMIN_APPOINTMENTS_PATH,
  ADMIN_APPOINTMENT_RESEND_ENDPOINT,
  ADMIN_APPOINTMENT_UPDATE_ENDPOINT,
  adminFilePath,
  customerStampState,
  formatAdminTimestamp,
  formatFileSize,
  internalStampState,
  PAYMENT_ROUTE_LABELS,
  PIPELINE_STAGE_LABELS,
  STATUS_LABELS,
} from '../../../lib/booking-admin';
import {
  APPOINTMENT_STATUSES,
  MAX_STORED_ADMIN_NOTES,
  PIPELINE_STAGES,
} from '../../../lib/booking-admin-entry';
import { TIMEZONE_NOTE } from '../../../lib/booking-copy';
import {
  APPOINTMENT_UPLOAD_TTL_HOURS,
  appointmentUploadUrl,
} from '../../../lib/booking-config';
import { formatSlot } from '../../../lib/booking-time';
import { issueAppointmentUploadToken } from '../../../lib/draft-token';
import AppointmentUpload from '../../../components/AppointmentUpload.svelte';
import { getDb, SERVICE_LABELS, type Appointment, type AppointmentFile } from '../../../lib/db';

// Validate before querying. The driver parameterizes, so this is defense in
// depth — its visible job is turning /admin/appointments/abc into a clean 404
// instead of a 500 from Postgres rejecting the cast. The upper bound is int4's:
// `id` is a SERIAL, and a larger number is a 22003 error, not a missing row.
// No leading zeros: /admin/appointments/0000000012/ is a second URL for the
// same row, and the canonical one is one character away.
const raw = Astro.params.id;
const id = typeof raw === 'string' && /^[1-9][0-9]{0,9}$/.test(raw) ? Number(raw) : null;
if (id === null || id < 1 || id > 2147483647) {
  return new Response('Not found', { status: 404 });
}

let appointment: Appointment | null = null;
let files: AppointmentFile[] = [];
let dbError: string | null = null;

try {
  const sql = getDb();
  const rows = (await sql`SELECT * FROM appointments WHERE id = ${id}`) as Appointment[];
  appointment = rows[0] ?? null;

  if (appointment) {
    files = (await sql`
      SELECT * FROM appointment_files WHERE appointment_id = ${id} ORDER BY id
    `) as AppointmentFile[];
  }
} catch (e) {
  dbError = 'Could not load appointment.';
  console.error(e);
}

// A row that does not exist is a 404, the same answer a bad id gets. A database
// that is down is not — that renders the error card below.
if (!appointment && !dbError) {
  return new Response('Not found', { status: 404 });
}

/**
 * BK-34a. The photo-upload capability for this appointment, in two forms: a
 * link the office texts, and the same uploader inline for an agent who already
 * has the files in their inbox.
 *
 * Minted here, in the page, because the page is already behind the middleware —
 * `/admin` is gated by prefix, so reaching this frontmatter *is* the
 * authorization, and a separate mint endpoint would only be a second thing to
 * protect.
 *
 * A FRESH TOKEN ON EVERY PAGE VIEW, which is deliberate rather than wasteful.
 * The caps count against `appointment_id` and not against the prefix, so a new
 * `draftId` grants no new budget; what it does mean is that links rotate, and
 * that a link pasted into a text message three weeks ago is not the same
 * capability as the one on screen now.
 *
 * Failure is non-fatal: this is a convenience on a page whose job is showing
 * the appointment. `BOOKING_DRAFT_SECRET` being unset must not 500 the record.
 */
let uploadToken: string | null = null;
let uploadDraftId: string | null = null;
let uploadExpiresAt: Date | null = null;
if (appointment) {
  try {
    const minted = await issueAppointmentUploadToken(appointment.id);
    uploadToken = minted.token;
    uploadDraftId = minted.draftId;
    uploadExpiresAt = minted.expiresAt;
  } catch (e) {
    console.error(`Could not mint an upload token for appointment ${appointment.id}:`, e);
  }
}
const uploadLink = uploadToken
  ? new URL(appointmentUploadUrl(uploadToken), Astro.site ?? Astro.url.origin).toString()
  : null;

// Four states per stamp, not two. `none` is BK-08's addition: an admin row with
// an email may simply not have been sent one, which "Not applicable" would now
// claim falsely.
const customerStamp = appointment ? customerStampState(appointment) : 'not-applicable';
const internalStamp = appointment ? internalStampState(appointment) : 'not-applicable';

// The confirmation button is offered only for a booked appointment with an
// email. A cancelled or no-show row must not receive a fresh "You're booked"
// for a slot that may since belong to somebody else — and the endpoint
// re-checks this rather than trusting the button's absence.
const canResend =
  !!appointment &&
  appointment.status === 'booked' &&
  typeof appointment.email === 'string' &&
  appointment.email.trim() !== '';

// Flashes. The `?email=` one is load-bearing rather than decorative: BK-07's
// warning flags deliberately never fire for `source = 'admin'` rows, so this is
// the only place a failed admin-entry send is surfaced at the moment it
// happens. Afterwards the neutral stamp and the resend button are the recovery.
const emailFlash = Astro.url.searchParams.get('email');
const savedFlash = Astro.url.searchParams.get('saved');

const EMAIL_MESSAGES: Record<string, { tone: 'ok' | 'warn'; text: string }> = {
  sent: { tone: 'ok', text: 'Confirmation email sent to the customer.' },
  failed: {
    tone: 'warn',
    text: 'The confirmation email did not send. The appointment is saved — use “Send confirmation” below to try again.',
  },
  // Reached from the entry form with the box unticked, and from either sender
  // when the mute flag is set. Worded for both — the page they are looking at
  // is itself the evidence the appointment saved.
  off: { tone: 'ok', text: 'No confirmation email was sent.' },
  refused: {
    tone: 'warn',
    text: 'A confirmation is only sent for a booked appointment with an email address.',
  },
};

const SAVED_MESSAGES: Record<string, { tone: 'ok' | 'warn'; text: string }> = {
  '1': { tone: 'ok', text: 'Saved.' },
  conflict: {
    tone: 'warn',
    text: 'That slot has since been rebooked, so this appointment stays cancelled. Nothing was saved.',
  },
  invalid: { tone: 'warn', text: 'That edit was not valid. Nothing was saved.' },
  error: { tone: 'warn', text: 'The database rejected that change. Nothing was saved.' },
};

const flashes = [
  emailFlash ? EMAIL_MESSAGES[emailFlash] : null,
  savedFlash ? SAVED_MESSAGES[savedFlash] : null,
].filter((f): f is { tone: 'ok' | 'warn'; text: string } => !!f);

function statusClasses(status: Appointment['status']) {
  if (status === 'completed') return 'bg-green-900/40 text-green-300 border-green-800';
  if (status === 'cancelled') return 'bg-zinc-800 text-zinc-500 border-zinc-700';
  if (status === 'no_show') return 'bg-red-900/40 text-red-300 border-red-800';
  return 'bg-blue-900/40 text-blue-300 border-blue-800';
}
---

<AdminLayout title={appointment ? `${appointment.name} — Appointment` : 'Appointment'}>
  <div class="mb-5">
    <a href={ADMIN_APPOINTMENTS_PATH} class="text-zinc-500 hover:text-zinc-300 text-sm transition-colors">
      ← All Appointments
    </a>
  </div>

  {flashes.map(flash => (
    <div
      class={`rounded-lg px-4 py-3 text-sm mb-5 border ${
        flash.tone === 'ok'
          ? 'bg-green-900/30 border-green-800 text-green-300'
          : 'bg-amber-900/30 border-amber-800/70 text-amber-200'
      }`}
    >
      {flash.text}
    </div>
  ))}

  {dbError && (
    <div class="bg-red-900/30 border border-red-800 rounded-lg px-4 py-3 text-red-300 text-sm">{dbError}</div>
  )}

  {appointment && (
    <div class="space-y-5">
      <!-- Visit -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <div class="flex items-start justify-between gap-4 mb-5">
          <div>
            <h1 class="text-white text-xl font-bold">{formatSlot(appointment.slot_start)}</h1>
            <p class="text-zinc-500 text-xs mt-1">
              {TIMEZONE_NOTE} · {appointment.duration_minutes} minutes · booking #{appointment.id}
            </p>
          </div>
          <span class={`inline-flex items-center px-2.5 py-1 rounded text-xs font-medium border shrink-0 ${statusClasses(appointment.status)}`}>
            {STATUS_LABELS[appointment.status]}
          </span>
        </div>

        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Service</dt>
            <dd class="text-white">{SERVICE_LABELS[appointment.service] ?? appointment.service}</dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Pipeline stage</dt>
            <dd class="text-white">{PIPELINE_STAGE_LABELS[appointment.pipeline_stage]}</dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Payment route</dt>
            <dd class="text-white">{PAYMENT_ROUTE_LABELS[appointment.payment_route]}</dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Source</dt>
            <dd class="text-white">{appointment.source === 'admin' ? 'Entered by office' : 'Booked online'}</dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Booked</dt>
            <dd class="text-white">{formatAdminTimestamp(appointment.created_at)}</dd>
          </div>
          {appointment.cancelled_at && (
            <div>
              <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Cancelled</dt>
              <dd class="text-red-300">{formatAdminTimestamp(appointment.cancelled_at)}</dd>
            </div>
          )}
        </dl>
      </div>

      <!-- Customer -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <h2 class="text-white font-semibold mb-4">Customer</h2>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Name</dt>
            <dd class="text-white">{appointment.name}</dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Phone</dt>
            <dd class="text-white">
              <a href={`tel:${appointment.phone}`} class="hover:text-amber-400 transition-colors">{appointment.phone}</a>
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Email</dt>
            <dd class="text-white">
              {appointment.email
                ? <a href={`mailto:${appointment.email}`} class="hover:text-amber-400 transition-colors">{appointment.email}</a>
                : <span class="text-zinc-600">Not provided</span>
              }
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Address</dt>
            <dd class="text-white">
              {appointment.address}<br />
              {appointment.city}{appointment.postal_code ? ` ${appointment.postal_code}` : ''}
            </dd>
          </div>
          {appointment.description && (
            <div class="sm:col-span-2">
              <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">What happened</dt>
              <dd class="text-white whitespace-pre-wrap bg-zinc-800/50 rounded-lg p-3 text-sm leading-relaxed">
                {appointment.description}
              </dd>
            </div>
          )}
        </dl>
      </div>

      <!--
        Insurance — the sanctioned admin surface for these identifiers
        (002-booking: "email and the admin panel only"). Absent entirely on the
        private route, rather than rendered empty.
      -->
      {appointment.payment_route === 'insurance' && (
        <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
          <h2 class="text-white font-semibold mb-4">Insurance</h2>
          <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
            <div>
              <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Insurer</dt>
              <dd class="text-white">{appointment.insurer_name ?? <span class="text-zinc-600">Not provided</span>}</dd>
            </div>
            <div>
              <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Policy number</dt>
              <dd class="text-white font-mono text-xs">{appointment.policy_number ?? <span class="text-zinc-600 font-sans text-sm">Not provided</span>}</dd>
            </div>
            <div>
              <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Claim number</dt>
              <dd class="text-white font-mono text-xs">{appointment.claim_number ?? <span class="text-zinc-600 font-sans text-sm">Not provided</span>}</dd>
            </div>
          </dl>
        </div>
      )}

      <!--
        Notifications. The two BK-05 stamps are the only ones that can be a
        FAILURE; consent and reminder are neutral states by design — a null
        consent is "no consent" (the timestamp is the consent), and a null
        reminder is expected on every row until BK-06 ships.

        BK-08 added a third neutral state, "None sent": an office-entered row
        with an email address may simply not have been sent one — the box was
        unticked, or the send failed — and "Not applicable" would now be a lie.
        Which of those it was is not recorded; the resend button recovers both.
      -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <div class="flex items-start justify-between gap-4 mb-4">
          <h2 class="text-white font-semibold">Notifications</h2>
          {canResend && (
            <form method="POST" action={ADMIN_APPOINTMENT_RESEND_ENDPOINT} class="shrink-0">
              <input type="hidden" name="id" value={String(appointment.id)} />
              <button
                type="submit"
                class="border border-amber-700/60 text-amber-300 hover:bg-amber-900/30 text-xs font-medium rounded-lg px-3 py-1.5 transition-colors"
              >
                {appointment.confirmation_sent_at ? 'Resend confirmation' : 'Send confirmation'}
              </button>
            </form>
          )}
        </div>
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Office notified</dt>
            <dd>
              {internalStamp === 'sent' ? (
                <span class="text-white">{formatAdminTimestamp(appointment.internal_notified_at!)}</span>
              ) : internalStamp === 'failed' ? (
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border bg-red-900/40 text-red-300 border-red-800">
                  Never sent — the office was not told
                </span>
              ) : (
                <span class="text-zinc-600">Not applicable</span>
              )}
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Customer confirmation</dt>
            <dd>
              {customerStamp === 'sent' ? (
                <span class="text-white">{formatAdminTimestamp(appointment.confirmation_sent_at!)}</span>
              ) : customerStamp === 'failed' ? (
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium border bg-amber-900/30 text-amber-300 border-amber-800/70">
                  Never sent
                </span>
              ) : customerStamp === 'none' ? (
                <span class="text-zinc-500">None sent</span>
              ) : (
                <span class="text-zinc-600">Not applicable</span>
              )}
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">SMS consent</dt>
            <dd class="text-white">
              {appointment.sms_consent_at
                ? formatAdminTimestamp(appointment.sms_consent_at)
                : <span class="text-zinc-500">No consent</span>
              }
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Assessment terms</dt>
            <dd class="text-white">
              {appointment.terms_acked_at
                ? formatAdminTimestamp(appointment.terms_acked_at)
                : appointment.source === 'admin'
                  ? <span class="text-zinc-500">Exempt — office entry</span>
                  /*
                    "Not recorded", not "Not acknowledged". A web row cannot
                    reach this arm once BK-27 is deployed — the endpoint refuses
                    the booking — so the only rows that ever show it are the
                    handful that predate migration 005. "Not acknowledged" reads
                    as a customer who refused; they were never asked.
                  */
                  : <span class="text-zinc-500">Not recorded — predates the terms</span>
              }
            </dd>
          </div>
          <div>
            <dt class="text-zinc-500 text-xs uppercase tracking-wide mb-1">Reminder</dt>
            <dd class="text-white">
              {appointment.reminder_sent_at
                ? formatAdminTimestamp(appointment.reminder_sent_at)
                : <span class="text-zinc-500">Not sent</span>
              }
            </dd>
          </div>
        </dl>
      </div>

      <!--
        Files. The Blob store is private and enforces it at the store level, so
        a direct URL here would 403 — each name links to the authenticated proxy
        instead, which 302s to a signed URL that dies after a few minutes.
        Pathnames and URLs are still not rendered even as text: the link carries
        the row id and nothing else.

        Pending rows render unlinked. Their bytes may not exist yet — the
        upload-completed webhook never fires against localhost — and a link that
        opens a CDN 404 is worse than no link. The ROUTE does not 404 them; this
        is presentation.
      -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <h2 class="text-white font-semibold mb-1">
          Files <span class="text-zinc-600 font-normal text-sm">({files.length})</span>
        </h2>
        <p class="text-zinc-600 text-xs mb-4">
          Links open in a new tab and expire after a few minutes. Click again for a fresh one.
        </p>

        {files.length === 0 ? (
          <p class="text-zinc-600 text-sm">No files attached.</p>
        ) : (
          <ul class="divide-y divide-zinc-800/60 text-sm">
            {files.map(file => (
              <li class="py-2.5 flex items-center justify-between gap-4">
                {file.upload_state === 'pending' ? (
                  <span class="text-zinc-400 truncate">{file.original_name ?? 'Unnamed file'}</span>
                ) : (
                  <a
                    href={adminFilePath(file.id)}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-amber-400 hover:text-amber-300 truncate transition-colors"
                  >
                    {file.original_name ?? 'Unnamed file'}
                  </a>
                )}
                <span class="text-zinc-500 text-xs shrink-0">
                  {formatFileSize(file.size_bytes)}
                  {file.upload_state === 'pending' && ' · upload not confirmed'}
                </span>
              </li>
            ))}
          </ul>
        )}
      </div>

      <!--
        BK-34a. Getting photos onto a PHONE booking, which until now was
        impossible — they arrived in somebody's inbox and stayed there.

        Two arms, one capability:

          - the link, which the office texts (BK-34b sends it automatically once
            the Twilio number is live; until then this is copy-paste);
          - the same uploader inline, for an agent who already has the files.

        The inline arm is why there is no multipart proxy in this feature. A
        100 MB video posted through a serverless function is the shape
        `booking-files.ts` rejects on the read side, and it would be a second
        upload path to keep correct. This one is the customer's path, running
        under a token the page just minted.
      -->
      <div class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <h2 class="text-white font-semibold mb-1">Get photos</h2>
        <p class="text-zinc-600 text-xs mb-5">
          Text the customer this link, or add files yourself if they emailed them.
        </p>

        {uploadLink ? (
          <>
            <label class="block text-zinc-400 text-xs uppercase tracking-wide mb-1.5" for="upload-link">
              Upload link
            </label>
            <input
              id="upload-link"
              type="text"
              readonly
              value={uploadLink}
              onfocus="this.select()"
              class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-xs text-zinc-300 font-mono focus:border-amber-500 focus:outline-none"
            />

            <!--
              BK-37. Until the Twilio number clears (BK-34b), the office agent's
              own phone IS the SMS gateway, which makes this row the delivery
              mechanism rather than a convenience.

              THE BUTTONS ARE RENDERED BY SCRIPT, NOT BY THE SERVER, and that is
              the point: `navigator.share` exists on the agent's phone and not
              on the desk machine, and which one is in front of the link is not
              knowable at build time. A server-rendered Share button that does
              nothing on a desktop is worse than no button — the agent taps it,
              nothing happens, and they stop trusting the row. The fallbacks are
              in the markup and Share is added to them when the API is really
              there; a browser with no JS at all keeps the readonly field, which
              is what the office had before this ticket.
            -->
            <div
              id="upload-link-actions"
              class="flex flex-wrap items-center gap-2 mt-2"
              data-url={uploadLink}
              data-message={`Send us photos or video of the damage here: ${uploadLink}`}
            >
              <button
                type="button"
                data-action="copy"
                class="border border-zinc-700 text-zinc-200 hover:bg-zinc-800 text-xs font-medium rounded-lg px-3 py-1.5 transition-colors"
              >
                Copy link
              </button>
              <a
                data-action="whatsapp"
                href={`https://wa.me/?text=${encodeURIComponent(`Send us photos or video of the damage here: ${uploadLink}`)}`}
                target="_blank"
                rel="noopener noreferrer"
                class="border border-zinc-700 text-zinc-200 hover:bg-zinc-800 text-xs font-medium rounded-lg px-3 py-1.5 transition-colors"
              >
                WhatsApp
              </a>
              <span data-role="status" class="text-xs text-emerald-400" role="status" aria-live="polite"></span>
            </div>

            <!--
              The expiry, stated absolutely rather than as "expires in 43h".
              A countdown would be a lie on this page: the token is re-minted on
              every view (see above), so the number would read 72h every single
              time and tell the office nothing about the link they texted on
              Tuesday.

              The second sentence is there because the first invites the wrong
              inference. Tokens are stateless HMACs with no revocation — opening
              this page does NOT kill the link already in a customer's messages,
              and an office that believes it does will re-send a link nobody
              needed and leave a live one they think is dead.
            -->
            {uploadExpiresAt && (
              <p class="text-zinc-500 text-xs mt-3 mb-6 leading-relaxed">
                This link works until <span class="text-zinc-300">{formatAdminTimestamp(uploadExpiresAt)}</span>.
                A fresh link is made each time you open this page; links you have already sent keep
                working until their own {APPOINTMENT_UPLOAD_TTL_HOURS} hours are up.
              </p>
            )}

            <p class="text-zinc-400 text-xs uppercase tracking-wide mb-2">Or add files here</p>
            <AppointmentUpload
              client:load
              token={uploadToken!}
              draftId={uploadDraftId!}
              variant="admin"
            />
          </>
        ) : (
          <p class="text-zinc-500 text-sm">
            Upload links are unavailable — BOOKING_DRAFT_SECRET is not configured.
          </p>
        )}
      </div>

      <!--
        The edit form. Status, stage and notes in ONE submit, because they are
        one UPDATE: a status change that collides rolls the whole statement
        back, and splitting the form would imply the notes survived when they
        did not.

        Cancelling is just the status select — there is no separate destructive
        button, and cancelling never deletes the row. Rescheduling is not here:
        it is cancel + re-enter (see the ticket's Out of scope).
      -->
      <form method="POST" action={ADMIN_APPOINTMENT_UPDATE_ENDPOINT} class="bg-zinc-900 border border-zinc-800 rounded-xl p-6">
        <input type="hidden" name="id" value={String(appointment.id)} />
        <h2 class="text-white font-semibold mb-1">Update</h2>
        <p class="text-zinc-600 text-xs mb-5">
          Cancelling frees the slot for online booking but keeps the record. Un-cancelling
          fails if somebody has taken the slot since.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
          <div>
            <label class="block text-zinc-400 text-xs uppercase tracking-wide mb-1.5" for="status">Status</label>
            <select
              id="status"
              name="status"
              class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-amber-500 focus:outline-none"
            >
              {APPOINTMENT_STATUSES.map(value => (
                <option value={value} selected={value === appointment.status}>
                  {STATUS_LABELS[value]}
                </option>
              ))}
            </select>
          </div>
          <div>
            <label class="block text-zinc-400 text-xs uppercase tracking-wide mb-1.5" for="pipeline_stage">
              Pipeline stage
            </label>
            <select
              id="pipeline_stage"
              name="pipeline_stage"
              class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white focus:border-amber-500 focus:outline-none"
            >
              {PIPELINE_STAGES.map(value => (
                <option value={value} selected={value === appointment.pipeline_stage}>
                  {PIPELINE_STAGE_LABELS[value]}
                </option>
              ))}
            </select>
          </div>
        </div>

        <div class="mb-5">
          <label class="block text-zinc-400 text-xs uppercase tracking-wide mb-1.5" for="admin_notes">
            Office notes
          </label>
          <textarea
            id="admin_notes"
            name="admin_notes"
            rows="4"
            maxlength={MAX_STORED_ADMIN_NOTES}
            class="w-full bg-zinc-950 border border-zinc-800 rounded-lg px-3 py-2 text-sm text-white placeholder-zinc-600 focus:border-amber-500 focus:outline-none"
            placeholder="Internal only — never sent to the customer."
          >{appointment.admin_notes ?? ''}</textarea>
        </div>

        <button
          type="submit"
          class="bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold text-sm rounded-lg px-5 py-2.5 transition-colors"
        >
          Save changes
        </button>
      </form>
    </div>
  )}
</AdminLayout>

<script>
  /**
   * BK-37 — getting the upload link out of this page and into a text message.
   *
   * Three behaviours, feature-detected in this order:
   *
   *   1. **Share**, added only when `navigator.share` is really present. On the
   *      agent's phone this opens the OS share sheet, which is the one route to
   *      Messages, WhatsApp and mail without the office retyping anything. It
   *      is added by script rather than rendered by the server because the
   *      server cannot know which device is asking, and a Share button that
   *      does nothing on a desk machine trains the agent to distrust the row.
   *   2. **Copy**, which needs `navigator.clipboard` — HTTPS or localhost only.
   *      When that is missing (an office on plain HTTP over a LAN, say) the
   *      button selects the field instead and says so, which still gets the
   *      link into the clipboard with one keystroke rather than failing mute.
   *   3. **WhatsApp**, a plain anchor in the markup. It is the desktop
   *      fallback, it needs no JS at all, and `wa.me` with no number opens the
   *      contact picker.
   *
   * `share()` rejects with an `AbortError` when the user dismisses the sheet.
   * That is a normal outcome, not a failure, and must not be reported as one —
   * a red "Could not share" on every dismissed sheet is how a working button
   * gets reported as broken.
   */
  const actions = document.getElementById('upload-link-actions');
  const field = document.getElementById('upload-link') as HTMLInputElement | null;

  if (actions && field) {
    const url = actions.dataset.url ?? '';
    const message = actions.dataset.message ?? url;
    const status = actions.querySelector<HTMLElement>('[data-role="status"]');

    let clearAt: ReturnType<typeof setTimeout> | undefined;
    const say = (text: string, ok = true) => {
      if (!status) return;
      status.textContent = text;
      status.className = `text-xs ${ok ? 'text-emerald-400' : 'text-amber-400'}`;
      clearTimeout(clearAt);
      clearAt = setTimeout(() => (status.textContent = ''), 4000);
    };

    actions.querySelector('[data-action="copy"]')?.addEventListener('click', async () => {
      try {
        if (!navigator.clipboard) throw new Error('no clipboard api');
        await navigator.clipboard.writeText(url);
        say('Link copied.');
      } catch {
        // Not a dead end: the field is still right there, and selecting it
        // leaves the agent one Ctrl-C away instead of nowhere.
        field.focus();
        field.select();
        say('Selected the link — press Ctrl/Cmd + C to copy.', false);
      }
    });

    if (typeof navigator.share === 'function') {
      const share = document.createElement('button');
      share.type = 'button';
      share.textContent = 'Share';
      share.className =
        'border border-amber-700/60 text-amber-300 hover:bg-amber-900/30 text-xs font-medium rounded-lg px-3 py-1.5 transition-colors';
      share.addEventListener('click', async () => {
        try {
          // `text` and `url` both, not `url` alone: several share targets drop
          // a bare URL into an empty message with no explanation of what the
          // customer is being asked to do.
          await navigator.share({ text: message, url });
        } catch (err) {
          // A dismissed share sheet is an AbortError and is not a failure.
          if ((err as DOMException)?.name !== 'AbortError') {
            say('Could not open the share sheet — copy the link instead.', false);
          }
        }
      });
      actions.prepend(share);
    }
  }
</script>
