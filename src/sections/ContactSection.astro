---
import ContactForm from '../components/ContactForm.svelte';
import NextOpening from '../components/NextOpening.svelte';
import {
  FEE_TERMS_HEADING,
  FEE_TERMS_INTRO,
  FEE_TERMS_ITEMS,
  FEE_TERMS_OUTRO,
} from '../lib/booking-copy';

interface Props {
  /**
   * Whether the right column is the real message form or a booking CTA card.
   *
   * BK-10 split the two: the form is the site's *question* path and renders on
   * `/contact/` only, so the homepage — where the intent is "I need help with
   * damage" — shows a card that leads to `/book/` instead. Two quote doors is
   * exactly what the cutover exists to remove.
   *
   * The left info column (phone, email, hours, service area) renders either
   * way: it is the homepage's NAP block and local-SEO surface, and only the
   * form left.
   */
  showForm?: boolean;
}

const { showForm = false } = Astro.props;
---

<section
  id="contact"
  class="relative bg-yeg-bg min-h-screen py-20 lg:py-0"
  style="z-index: 60;"
>
  <!-- Background Word -->
  <div
    class="absolute bg-word opacity-[0.06]"
    style="left: 4vw; top: 8vh;"
  >
    RESPONSE
  </div>

  <div class="relative w-full min-h-screen flex items-center">
    <div
      class="w-full flex flex-col lg:flex-row items-start lg:items-center gap-12 lg:gap-0 px-6 lg:px-[8vw] py-12 lg:py-0"
    >
      <!-- Left Column — Info -->
      <div data-contact-left class="w-full lg:w-[40%]">
        <h2 class="font-display font-extrabold text-display-lg text-yeg-text mb-4">
          {showForm ? 'Send Us a Message' : 'Book Your Assessment'}
        </h2>
        <p class="text-yeg-text-secondary text-lg leading-relaxed max-w-md mb-10">
          {
            /*
              BK-27, implementation review blocker 1: the `showForm === false`
              arm is the HOMEPAGE BOOKING SECTION — the same section as the
              terms box below — and it read "no obligation" one screen above a
              box that prices declining. That phrase came out of `book.astro`'s
              header and out of the island's step 1 for exactly this reason and
              was left standing here. `no obligation` is actively false — and
              more so since 2026-08-14 than when this was written. Under the
              superseded waiver model the obligation was contingent (declining
              carried a potential $699). Under the credit model EVERY customer
              owes the fee at the visit and only gets it back by going ahead, so
              there is no reading on which a visitor has no obligation.

              2026-08-14: the `<h2>` above and the CTA button below both said
              "Free Assessment" and were parked as copy judgment, on the reading
              that the claim held for customers who go ahead. THE PRICING MODEL
              CHANGED THAT. Under the credit model nobody gets a free assessment
              at the point of sale — every customer pays on the day — so both
              strings went from "conditionally true" to false, sitting inches
              from a box that prices the visit. Reworded here rather than parked
              for BK-29, on blocker 1's own reasoning: BK-29 owns the ~50 claims
              on OTHER pages; a contradiction inside the box's own section is
              this ticket's. The pin below now enforces both.
            */
            showForm
              ? "Questions get answered the same business day. Emergencies get answered on the first ring."
              : "Pick a time that works and a certified tech comes out — about 30 minutes. Emergency? Call; we answer live."
          }
        </p>

        <!-- Contact Details -->
        <div class="space-y-5 mb-10">
          <a
            href="tel:+17804793285"
            class="flex items-center gap-4 text-yeg-text hover:text-yeg-amber-deep transition-colors group"
          >
            <div
              class="w-10 h-10 rounded-full bg-yeg-bg-light border border-black/10 flex items-center justify-center group-hover:border-yeg-amber/50 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path
                  d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12 19.79 19.79 0 0 1 1.73 3.35a2 2 0 0 1 1.48-2.18H6.09a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L7.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 21 16.92z"
                ></path>
              </svg>
            </div>
            <div>
              <p class="text-xs text-yeg-text-secondary uppercase tracking-wider mb-0.5">
                Emergency Line
              </p>
              <p class="font-semibold">(780) 479-3285</p>
              <p class="text-xs text-yeg-text-secondary/70 mt-0.5">
                We answer every call live — no voicemail.
              </p>
            </div>
          </a>

          <a
            href="mailto:info@yegrestoration.ca"
            class="flex items-center gap-4 text-yeg-text hover:text-yeg-amber-deep transition-colors group"
          >
            <div
              class="w-10 h-10 rounded-full bg-yeg-bg-light border border-black/10 flex items-center justify-center group-hover:border-yeg-amber/50 transition-colors"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
              </svg>
            </div>
            <div>
              <p class="text-xs text-yeg-text-secondary uppercase tracking-wider mb-0.5">Email</p>
              <p class="font-semibold">info@yegrestoration.ca</p>
            </div>
          </a>

          <div class="flex items-center gap-4 text-yeg-text">
            <div
              class="w-10 h-10 rounded-full bg-yeg-bg-light border border-black/10 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div>
              <p class="text-xs text-yeg-text-secondary uppercase tracking-wider mb-0.5">Hours</p>
              <p class="font-semibold">Open 24/7 — including holidays</p>
            </div>
          </div>

          <div class="flex items-center gap-4 text-yeg-text">
            <div
              class="w-10 h-10 rounded-full bg-yeg-bg-light border border-black/10 flex items-center justify-center"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <p class="text-xs text-yeg-text-secondary uppercase tracking-wider mb-0.5">
                Service Area
              </p>
              <p class="font-semibold">Edmonton &amp; 31 communities across Alberta</p>
            </div>
          </div>
        </div>

        <!-- Trust Line -->
        <div class="flex items-center gap-4 text-xs text-yeg-text-secondary">
          <div class="flex items-center gap-1.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-yeg-amber-deep"
              aria-hidden="true"
            >
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
            </svg>
            <span>IICRC certified</span>
          </div>
          <span>&bull;</span>
          <div class="flex items-center gap-1.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="currentColor"
              stroke="currentColor"
              stroke-width="1"
              class="text-yeg-amber-deep"
              aria-hidden="true"
            >
              <polygon
                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"
              ></polygon>
            </svg>
            <span>Local</span>
          </div>
          <span>&bull;</span>
          <div class="flex items-center gap-1.5">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="text-yeg-amber-deep"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
            <span>24/7</span>
          </div>
        </div>
      </div>

      <!-- Right Column — the message form, or the booking CTA card -->
      <div
        data-contact-form
        class="w-full lg:w-[50%] lg:ml-auto"
        style="perspective: 1000px;"
      >
        {
          showForm ? (
            <ContactForm client:visible />
          ) : (
            <div
              data-contact-stagger
              class="bg-white border border-black/10 rounded-xl p-6 lg:p-10 shadow-[0_4px_24px_rgba(0,0,0,0.06)]"
            >
              <p class="text-xs font-medium text-yeg-amber-deep uppercase tracking-widest mb-3">
                Credited in full when you go ahead
              </p>
              <h3 class="font-display font-bold text-2xl text-yeg-text mb-3">
                Book a time that works for you
              </h3>
              <p class="text-yeg-text-secondary leading-relaxed mb-6">
                An IICRC-certified tech comes out, looks at the damage, and tells you what it takes
                to put it right. About 30 minutes — you'll see the open times before you give us
                anything.
              </p>
              <ul class="space-y-2 mb-6 text-sm text-yeg-text-secondary">
                <li>Instant confirmation — no waiting for a callback</li>
                <!--
                  BK-22 made a photo mandatory, so the old "photos optional"
                  line went false. It is customer-facing copy about the booking
                  form that lives outside the island, and no gate reads it —
                  `verify-cutover.ts` sweeps CTAs and paths, not claims — so it
                  is only ever as true as the last person to remember it.
                  The line above it ("Instant confirmation") goes false with
                  BK-23 and is that ticket's to rewrite.
                -->
                <li>Send a photo or two — we arrive with the right equipment</li>
                <li>Insurance claim? We document it the way your adjuster needs</li>
              </ul>

              {/*
                BK-27's fee terms. THIS BRANCH ONLY — `/contact/` renders the
                message form instead, and it is not a booking surface; putting
                assessment pricing beside "send us a message" would price a
                question. The strings come from `booking-copy.ts`, the same
                constants the form's step 3 and the confirmation email read, so
                the client edits the wording in one file. Never retype the
                figures here — hand-typed facts in copy are exactly the (780)
                244-4747 trap.
              */}
              <div class="rounded-lg border border-black/10 bg-black/[0.03] px-4 py-3 mb-6">
                <p class="text-sm font-semibold text-yeg-text">{FEE_TERMS_HEADING}</p>
                <p class="text-xs text-yeg-text-secondary mt-1">{FEE_TERMS_INTRO}</p>
                <ul class="mt-2 space-y-1 text-xs text-yeg-text-secondary list-disc pl-5">
                  {FEE_TERMS_ITEMS.map((item) => <li>{item}</li>)}
                </ul>
                {FEE_TERMS_OUTRO.map((line) => (
                  <p class="text-xs text-yeg-text-secondary mt-2">{line}</p>
                ))}
              </div>

              {/*
                BK-39. The teaser is read-only and links nowhere — it prints
                one line from the public availability endpoint and renders
                NOTHING on any failure. `client:visible` because this section
                is the last on the homepage: hydrating it at load would put a
                fetch in front of the hero's LCP for a line nobody has scrolled
                to yet.

                The booking WIZARD stays off the homepage. One door per intent
                is the BK-10 cutover's whole point, and a second copy of the
                picker here would be the second door.
              */}
              <NextOpening client:visible />

              {/*
                "See available times" rather than "Book Your Assessment": the
                button leads to a page whose first screen is a calendar, and
                naming that is both more honest and a lower-commitment ask —
                the visitor is one click from looking, not from booking.
              */}
              <a href="/book/" class="cta-primary w-full justify-center">
                <span>See available times</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <p class="text-xs text-yeg-text-secondary text-center mt-4">
                Not ready to book? <a
                  href="/contact/"
                  class="text-yeg-amber-deep font-semibold underline underline-offset-2"
                >Send us a message</a> instead.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector('#contact');
  if (section) {
    const leftCol = section.querySelector('[data-contact-left]');
    const formCard = section.querySelector('[data-contact-form]');
    // `.form-field` is the message form's own hook (/contact/); the second
    // selector is the booking CTA card that replaces it on the homepage, so
    // the stagger survives the split rather than silently animating nothing.
    const formFields = section.querySelectorAll('.form-field, [data-contact-stagger] > *');

    // A fresh config per tween. One shared object handed to three ScrollTriggers
    // is three instances holding one mutable `vars`; they are identical here, so
    // there is nothing to gain from sharing and a class of cross-talk to lose.
    const trigger = () => ({ trigger: section, start: 'top 85%', once: true });

    /**
     * BK-42. **The reveal must not be the only thing standing between a visitor
     * and the CTA.**
     *
     * A `from()` tween sets the start state, then re-reads the element to learn
     * what to animate back to. On an element with a CSS transition that read can
     * land mid-transition and record the START value as the destination, so the
     * tween runs 0 -> 0 and the element never appears. That shipped: the
     * homepage booking CTA was invisible in production, because `.cta-primary`
     * was the only child of this stagger carrying a transition.
     *
     * `global.css` now keeps `opacity` out of that transition, which fixes the
     * fade. This clears the inline styles GSAP wrote once the tween is done, so
     * the final state is the stylesheet's regardless of what GSAP recorded —
     * including the `transform` residue, which the CTA still transitions for its
     * hover scale and which otherwise leaves the button 16px low forever.
     *
     * Anything added to this card inherits the guarantee. Do not remove it to
     * "clean up" — a reveal animation that can strand the page's primary
     * conversion element is worth an unconditional net.
     */
    const settle = (targets: gsap.TweenTarget) => () => {
      gsap.set(targets, { clearProps: 'opacity,transform,translate,rotate,scale' });
    };

    if (leftCol) {
      gsap.from(leftCol, { x: '-8vw', opacity: 0, duration: 0.7, ease: 'power2.out', scrollTrigger: trigger(), onComplete: settle(leftCol) });
    }

    if (formCard) {
      gsap.from(formCard, { x: '8vw', opacity: 0, rotateY: 6, duration: 0.7, ease: 'power2.out', scrollTrigger: trigger(), onComplete: settle(formCard) });
    }

    if (formFields.length) {
      gsap.from(formFields, { y: 16, opacity: 0, stagger: 0.06, duration: 0.7, ease: 'power2.out', scrollTrigger: trigger(), onComplete: settle(formFields) });
    }
  }
</script>
