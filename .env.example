# Copy the values you need into .env.local (never commit real values).

# --- Lead backend ---
DATABASE_URL=            # Neon Postgres connection string
ADMIN_PASSWORD=          # /admin panel password
RESEND_API_KEY=          # transactional email

# --- Booking system ---
# Blob store must be created with access set to PRIVATE (damage photos are
# attached to insurance claims). Vercel adds BLOB_READ_WRITE_TOKEN to the
# project automatically when the store is created — include the Development
# environment on the store connection so `vercel env pull` picks it up.
BLOB_READ_WRITE_TOKEN=   # long-lived Blob token; required to mint client upload tokens
BOOKING_DRAFT_SECRET=    # random 32+ char string; signs booking draft/upload sessions
CRON_SECRET=             # random 32+ char string; Vercel sends it as a Bearer token to /api/cron/*

# --- GA4 + Google Ads tracking (optional — site ships with tracking dormant) ---
# Setup guide: docs/google-ads-tracking-setup.md
PUBLIC_GA4_ID=           # G-XXXXXXXXXX  (GA4 Measurement ID)
PUBLIC_AW_ID=            # AW-XXXXXXXXXX (Google Ads conversion ID)
PUBLIC_AW_CALL_LABEL=    # call conversion label (string after AW-XXXX/)
PUBLIC_AW_FORM_LABEL=    # form conversion label
PUBLIC_AW_BOOKING_LABEL= # booked-assessment conversion label (separate action from the form)
